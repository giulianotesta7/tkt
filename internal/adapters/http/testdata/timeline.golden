
<div id="timeline">




  <article class="timeline-entry timeline-event st-new">
    <div class="timeline-entry-head">
      <div class="narrative"><strong class="timeline-actor">Admin</strong> <span class="timeline-action">created the ticket</span></div>
      <div class="when"><time datetime="2026-08-06T10:00:00Z" title="10:00 · 06-08-2026">10:00 · 06-08-2026</time></div>
    </div>
  </article>





  <article class="timeline-entry timeline-event st-in_progress">
    <div class="timeline-entry-head">
      <div class="narrative"><strong class="timeline-actor">Admin</strong> <span class="timeline-action">moved the ticket to in progress</span></div>
      <div class="when"><time datetime="2026-08-06T10:30:00Z" title="10:30 · 06-08-2026">10:30 · 06-08-2026</time></div>
    </div>
  </article>





  <article class="timeline-entry timeline-event">
    <div class="timeline-entry-head">
      <div class="narrative"><strong class="timeline-actor">Admin</strong> <span class="timeline-action">assigned the ticket to Ana Torres</span></div>
      <div class="when"><time datetime="2026-08-06T10:30:00Z" title="10:30 · 06-08-2026">10:30 · 06-08-2026</time></div>
    </div>
  </article>




  <article class="timeline-entry timeline-comment">
    <div class="timeline-entry-head">
      <div class="narrative"><strong class="timeline-actor">Ana Torres</strong> <span class="timeline-action">added a comment</span></div>
      <div class="when"><time datetime="2026-08-06T10:30:00Z" title="10:30 · 06-08-2026">10:30 · 06-08-2026</time></div>
    </div>
