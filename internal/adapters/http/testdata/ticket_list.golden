<div id="ticket-list" data-view="" data-sort="newest">
  <div class="queue-shell">
    <table class="queue queue-with-sla">
      <thead>
        <tr><th>ID</th><th>Ticket</th><th>Category</th><th>Assignee</th><th>Priority</th><th>State</th><th>SLA</th><th>Updated</th></tr>
      </thead>
      <tbody>
        <tr class="queue-row" data-href="/tickets/2">
          <td class="num" data-label="ID">TKT-2</td>
          <td class="cell-title" data-label="Ticket"><a class="queue-title" href="/tickets/2">Printer jam</a><span class="queue-requester"></span></td>
          <td class="cell-muted queue-category" data-label="Category"></td>
          <td data-label="Assignee"><span class="queue-assignee queue-unassigned">Unassigned</span></td>
          <td class="priority high" data-label="Priority"><span class="ticket-priority-value">High</span></td>
          <td data-label="State"><span class="badge in_progress">In Progress</span></td>
          <td data-label="SLA"><span class="sla-state"><span class="sla-dot at_risk" aria-hidden="true"></span><span class="sla-state-word">At Risk</span></span> </td>
          <td class="cell-muted queue-updated" data-label="Updated"><time datetime="2026-08-06T10:30:00Z" title="10:30 · 06-08-2026">10:30 · 06-08-2026</time></td>
        </tr>
        <tr class="queue-row" data-href="/tickets/1">
          <td class="num" data-label="ID">TKT-1</td>
          <td class="cell-title" data-label="Ticket"><a class="queue-title" href="/tickets/1">Login page down</a><span class="queue-requester"></span></td>
          <td class="cell-muted queue-category" data-label="Category"></td>
          <td data-label="Assignee"><span class="queue-assignee queue-unassigned">Unassigned</span></td>
          <td class="priority critical" data-label="Priority"><span class="ticket-priority-value">Critical</span></td>
          <td data-label="State"><span class="badge new">New</span></td>
          <td data-label="SLA"></td>
          <td class="cell-muted queue-updated" data-label="Updated"><time datetime="2026-08-06T10:00:00Z" title="10:00 · 06-08-2026">10:00 · 06-08-2026</time></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>