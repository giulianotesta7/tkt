
<div id="ticket-detail">

  <div class="command-header">
    <div>
      <div class="meta-row">
        <a href="/tickets">← Queue</a>
        <span class="num">TKT-1</span>
        <span class="badge in_progress">In Progress</span>
        <span class="priority high">High</span>
      </div>
      <h1 class="command-title">Login page down</h1>
      <div class="meta-row ticket-metadata">
        <span>Requester: Ana Torres &lt;ana@example.com&gt;</span>
        <span>Created <time datetime="2026-08-06T10:00:00Z">10:00 · 06-08-2026</time></span>
        <span>Updated <time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time></span>
      </div>
    </div>
  </div>
  <div class="cards">
    <div class="conversation">
      <div class="card">
        <h2>Description</h2>
        <p>The login form 500s on submit</p>
      </div>

<form class="card" method="post" action="/tickets/1/comments">
  <h2>Add comment</h2>
  
  <div class="field">
    <textarea name="body" placeholder="Write a comment…" aria-label="Comment body"></textarea>
  </div>
  <input type="hidden" name="visibility" value="public">

  <div class="field checkbox-field">
    <label for="comment-internal"><input id="comment-internal" type="checkbox" name="internal" value="1"> Internal comment</label>
    <p class="help">Only staff can see internal comments.</p>
  </div>

  <button class="btn primary" type="submit">Add comment</button>
</form>

      <div class="card">
        <h2>Timeline</h2>

<div id="timeline">


  <div class="timeline-entry timeline-comment">
    <div class="who">
      <span class="author">Ana Torres</span>
      <span class="when"><time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time></span>
    </div>
    <div class="body">Checking now</div>
  </div>



  <div class="timeline-entry timeline-event">
    <span class="dot update"></span>
    <div class="body">
      <div class="main">Update · Assigned To · Unassigned → Ana Torres</div>

      <div class="when"><time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time> · Admin</div>
    </div>
  </div>



  <div class="timeline-entry timeline-event">
    <span class="dot transition"></span>
    <div class="body">
      <div class="main">Transition · State · New → In Progress</div>

      <div class="when"><time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time> · Admin</div>
    </div>
  </div>



  <div class="timeline-entry timeline-event">
    <span class="dot created"></span>
    <div class="body">
      <div class="main">Created</div>

      <div class="when"><time datetime="2026-08-06T10:00:00Z">10:00 · 06-08-2026</time> · Admin</div>
    </div>
  </div>


</div>

      </div>
    </div>
    <div class="evidence">
      <details open id="details" class="card property-form">
        <summary>Details</summary>
        <form method="post" action="/tickets/1/edit">
        <div class="field">
          <label for="ticket-title">Title</label>
          <input type="text" id="ticket-title" name="title" value="Login page down" required>
        </div>
        <div class="field">
          <label for="ticket-category-value">Category</label>
          <p id="ticket-category-value" class="field-value">Bugs</p>
        </div>
        <div class="field">
          <label for="ticket-priority">Priority</label>
          <select id="ticket-priority" name="priority">
            <option value="critical" >Critical</option><option value="high" selected>High</option><option value="medium" >Medium</option><option value="low" >Low</option>
          </select>
        </div>
        <button class="btn primary" type="submit">Save properties</button>
        </form>
      </details>
      <details open id="assignment" class="card property-form">
        <summary>Assignment</summary>
        <form method="post" action="/tickets/1/assign">
        <div class="field">
          <label for="assign-user">Assigned To</label>
          <select id="assign-user" name="user_id">
            <option value="">Unassigned</option>
            <option value="1" selected>Ana Torres</option>
          </select>
        </div>
        <div class="field">
          <label for="assign-reason">Reason</label>
          <input type="text" id="assign-reason" name="reason" placeholder="Required when reassigning">
        </div>
        <button class="btn primary" type="submit">Save assignment</button>
        </form>
      </details>
      <details open id="state" class="card state-card">
        <summary>State</summary>
        <div class="current-state">Current <span class="badge in_progress">In Progress</span></div>
        <form class="transition-form" method="post" action="/tickets/1/transition">
          <div class="field">
            <label for="ticket-state">Move to</label>
            <select id="ticket-state" name="to">
              <option value="resolved">Resolved</option><option value="cancelled">Cancelled</option>
            </select>
          </div>
          <div class="field">
            <label for="transition-reason">Reason</label>
            <input type="text" id="transition-reason" name="reason" placeholder="Required when reopening a closed ticket">
          </div>
          <button class="btn primary" type="submit">Update state</button>

        </form>


      </details>
    </div>
  </div>
</div>
<script>
(() => {
  const key = "tkt:ticket-detail:collapsed:v1";
  const cards = document.querySelectorAll("#ticket-detail details[id]");
  let collapsed = [];
  try {
    const stored = JSON.parse(localStorage.getItem(key) || "[]");
    collapsed = Array.isArray(stored) ? stored : [];
  } catch (_) {}
  cards.forEach((card) => {
    card.open = !collapsed.includes(card.id);
    card.addEventListener("toggle", () => {
      collapsed = Array.from(cards).filter((item) => !item.open).map((item) => item.id);
      localStorage.setItem(key, JSON.stringify(collapsed));
    });
  });
})();
</script>
