
<div id="ticket-detail">
  
  <div class="command-header">
    <div>
      <div class="meta-row">
        <a href="/tickets">← Queue</a>
        <span class="num">TKT-1</span>
        <span class="badge in_progress">in_progress</span>
        <span class="priority high">high</span>
      </div>
      <h1 class="command-title">Login page down</h1>
      <div class="meta-row">
        <span>Requester: Ana Torres &lt;ana@example.com&gt;</span>
        <span>Created 2026-08-06T10:00:00Z</span>
        <span>Updated 2026-08-06T10:30:00Z</span>
      </div>
    </div>
    <div class="command-actions">
      <a class="btn ghost" href="/tickets/1/edit">Edit</a>
    </div>
  </div>
  <div class="cards">
    <div class="conversation">
      <div class="card">
        <h2>Details</h2>
        <dl class="kv">
          <dt>Category</dt>
          <dd>Bugs</dd>
          <dt>Assigned to</dt>
          <dd>Ana Torres</dd>
          
          
        </dl>
      </div>
      <div class="card">
        <h2>Description</h2>
        <p>The login form 500s on submit</p>
      </div>
      
<form class="card" method="post" action="/tickets/1/comments">
  <h2>Add comment</h2>
  
  <div class="field">
    <textarea name="body" placeholder="Write a comment…" aria-label="Comment body"></textarea>
  </div>
  <button class="btn primary" type="submit">Add comment</button>
</form>

      <div class="card">
        <h2>Comments</h2>
        
<div id="comment-list">
  
  <div class="comment">
    <div class="who">
      <span class="author">Ana Torres</span>
      <span class="when">2026-08-06T10:30:00Z</span>
    </div>
    <div class="body">Checking now</div>
  </div>
  
</div>

      </div>
    </div>
    <div class="evidence">
      <div class="card activity">
        <h2>Activity</h2>
        

<div class="event">
  <span class="dot created"></span>
  <div class="body">
    <div class="main">created</div>
    
    <div class="when">2026-08-06T10:00:00Z · Admin</div>
  </div>
</div>

<div class="event">
  <span class="dot transition"></span>
  <div class="body">
    <div class="main">transition · state · new → in_progress</div>
    
    <div class="when">2026-08-06T10:30:00Z · Admin</div>
  </div>
</div>


      </div>
      <div class="card">
        <h2>Transition</h2>
        <form class="transition-form" method="post" action="/tickets/1/transition">
          <select name="to" aria-label="Target state">
            <option value="resolved">resolved</option><option value="cancelled">cancelled</option>
          </select>
          <input type="text" name="reason" placeholder="Reason (reopen only)" aria-label="Transition reason">
          <button class="btn primary" type="submit">Move</button>
        </form>
        
      </div>
    </div>
  </div>
</div>
