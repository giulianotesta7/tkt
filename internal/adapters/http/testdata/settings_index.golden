<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>tkt — Ticket Desk</title>

<script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script>
</head>
<body>
<div class="layout">
  <aside class="rail">
    <a class="rail-brand" href="/tickets" title="tkt">tkt</a>
    <nav class="rail-nav">
      <a class="rail-link" href="/tickets" title="Tickets" aria-label="Tickets">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
      </a>
<a class="rail-link" href="/users" title="Users" aria-label="Users">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17.5" cy="9" r="2.5"/><path d="M16 14.6a6 6 0 0 1 5.5 5.4"/></svg>
      </a>


<a class="rail-link active" href="/settings" title="Settings" aria-label="Settings">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
      </a>
    </nav>
    <div class="rail-operator" title="Ana Torres">AT</div>
    <form class="rail-logout" method="post" action="/logout">
      <button class="rail-link" type="submit" title="Log out" aria-label="Log out">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3"/><path d="M15 8l4 4-4 4"/><path d="M19 12H9"/></svg>
      </button>
    </form>
  </aside>
  <main class="main">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>

<div class="command-header">
  <div>
    <h1 class="command-title">Settings</h1>
    <p class="command-sub">Instance appearance</p>
  </div>
</div>

<form class="card form-card" method="post" action="/settings/appearance">
  <h2>Appearance</h2>
  <p class="help">Background color for internal comments on ticket timelines.</p>
  <div class="swatch-grid">

    <label class="swatch">
    <input type="radio" name="internal_comment_bg" value="#E8EEFF" checked>
      <span class="swatch-chip" style="background:#E8EEFF"></span>
      <span class="swatch-label">Blue</span>
    </label>

    <label class="swatch">
    <input type="radio" name="internal_comment_bg" value="#EFE9FB">
      <span class="swatch-chip" style="background:#EFE9FB"></span>
      <span class="swatch-label">Violet</span>
    </label>

    <label class="swatch">
    <input type="radio" name="internal_comment_bg" value="#FFF6DC">
      <span class="swatch-chip" style="background:#FFF6DC"></span>
      <span class="swatch-label">Yellow</span>
    </label>

  </div>
  <button class="btn primary" type="submit">Save appearance</button>
</form>
</main>
</div>
</body>
</html>
