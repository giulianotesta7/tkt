<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>tkt — Ticket Desk</title>

<script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script>
</head>
<body>
<div class="layout">
  <aside class="rail">
    <a class="rail-brand" href="/tickets" title="tkt">tkt</a>
    <nav class="rail-nav">
      <a class="rail-link" href="/tickets" title="Tickets" aria-label="Tickets">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
      </a>
<a class="rail-link" href="/users" title="Users" aria-label="Users">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17.5" cy="9" r="2.5"/><path d="M16 14.6a6 6 0 0 1 5.5 5.4"/></svg>
      </a>


<a class="rail-link active" href="/settings" title="Settings" aria-label="Settings">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
      </a>
    </nav>
    <div class="rail-operator" title="Ana Torres">AT</div>
    <form class="rail-logout" method="post" action="/logout">
      <button class="rail-link" type="submit" title="Log out" aria-label="Log out">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3"/><path d="M15 8l4 4-4 4"/><path d="M19 12H9"/></svg>
      </button>
    </form>
  </aside>
  <main class="main">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>

<div class="command-header">
  <div>
    <h1 class="command-title">Settings</h1>
    <p class="command-sub">Instance configuration</p>
  </div>
</div>

<form class="card form-card" method="post" action="/settings/appearance">
  <h2>Appearance</h2>
  <p class="help">Background color for internal comments on ticket timelines.</p>
  <div class="swatch-grid">

    <label class="swatch">
    <input type="radio" name="internal_comment_bg" value="#E8EEFF" checked>
      <span class="swatch-chip" style="background:#E8EEFF"></span>
      <span class="swatch-label">Blue</span>
    </label>

    <label class="swatch">
    <input type="radio" name="internal_comment_bg" value="#EFE9FB">
      <span class="swatch-chip" style="background:#EFE9FB"></span>
      <span class="swatch-label">Violet</span>
    </label>

    <label class="swatch">
    <input type="radio" name="internal_comment_bg" value="#FFF6DC">
      <span class="swatch-chip" style="background:#FFF6DC"></span>
      <span class="swatch-label">Yellow</span>
    </label>

  </div>
  <button class="btn primary" type="submit">Save appearance</button>
</form>
<form class="card form-card" method="post" action="/settings/sla">
  <h2>Service level agreements</h2>
  <p class="help">Defaults for new categories. Editing them does not change existing categories.</p>
  <div class="field checkbox-field">
    <label><input type="checkbox" name="sla_enabled" value="1"> Enable SLA targets</label>
    <p class="help">Off by default. Existing commitments keep rendering.</p>
  </div>
  <div class="field">
    <label for="sla_warning_percent">Warning threshold</label>
    <input type="number" id="sla_warning_percent" name="sla_warning_percent" class="sla-warning-input" min="1" max="99" value="80">
    <p class="help">At risk once this share of the target has elapsed.</p>
  </div>
<div class="sla-grid">
  <div class="sla-grid-row sla-grid-head" aria-hidden="true">
    <span class="sla-grid-priority"></span>
    <span class="sla-grid-milestone">First response</span>
    <span class="sla-grid-milestone">Resolve</span>
  </div>

  <div class="sla-grid-row">
    <span class="sla-grid-priority">Critical</span>
    <div class="sla-target">
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">h</span><input type="number" inputmode="numeric" min="0" name="first_response_h_critical" value="0" aria-label="Critical first response, hours"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">m</span><input type="number" inputmode="numeric" min="0" max="59" name="first_response_m_critical" value="30" aria-label="Critical first response, minutes"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">s</span><input type="number" inputmode="numeric" min="0" max="59" name="first_response_s_critical" value="0" aria-label="Critical first response, seconds"></span>
    </div>
    <div class="sla-target">
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">h</span><input type="number" inputmode="numeric" min="0" name="resolve_h_critical" value="4" aria-label="Critical resolve, hours"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">m</span><input type="number" inputmode="numeric" min="0" max="59" name="resolve_m_critical" value="0" aria-label="Critical resolve, minutes"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">s</span><input type="number" inputmode="numeric" min="0" max="59" name="resolve_s_critical" value="0" aria-label="Critical resolve, seconds"></span>
    </div>
  </div>

  <div class="sla-grid-row">
    <span class="sla-grid-priority">High</span>
    <div class="sla-target">
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">h</span><input type="number" inputmode="numeric" min="0" name="first_response_h_high" value="1" aria-label="High first response, hours"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">m</span><input type="number" inputmode="numeric" min="0" max="59" name="first_response_m_high" value="0" aria-label="High first response, minutes"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">s</span><input type="number" inputmode="numeric" min="0" max="59" name="first_response_s_high" value="0" aria-label="High first response, seconds"></span>
    </div>
    <div class="sla-target">
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">h</span><input type="number" inputmode="numeric" min="0" name="resolve_h_high" value="8" aria-label="High resolve, hours"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">m</span><input type="number" inputmode="numeric" min="0" max="59" name="resolve_m_high" value="0" aria-label="High resolve, minutes"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">s</span><input type="number" inputmode="numeric" min="0" max="59" name="resolve_s_high" value="0" aria-label="High resolve, seconds"></span>
    </div>
  </div>

  <div class="sla-grid-row">
    <span class="sla-grid-priority">Medium</span>
    <div class="sla-target">
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">h</span><input type="number" inputmode="numeric" min="0" name="first_response_h_medium" value="4" aria-label="Medium first response, hours"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">m</span><input type="number" inputmode="numeric" min="0" max="59" name="first_response_m_medium" value="0" aria-label="Medium first response, minutes"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">s</span><input type="number" inputmode="numeric" min="0" max="59" name="first_response_s_medium" value="0" aria-label="Medium first response, seconds"></span>
    </div>
    <div class="sla-target">
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">h</span><input type="number" inputmode="numeric" min="0" name="resolve_h_medium" value="24" aria-label="Medium resolve, hours"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">m</span><input type="number" inputmode="numeric" min="0" max="59" name="resolve_m_medium" value="0" aria-label="Medium resolve, minutes"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">s</span><input type="number" inputmode="numeric" min="0" max="59" name="resolve_s_medium" value="0" aria-label="Medium resolve, seconds"></span>
    </div>
  </div>

  <div class="sla-grid-row">
    <span class="sla-grid-priority">Low</span>
    <div class="sla-target">
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">h</span><input type="number" inputmode="numeric" min="0" name="first_response_h_low" value="8" aria-label="Low first response, hours"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">m</span><input type="number" inputmode="numeric" min="0" max="59" name="first_response_m_low" value="0" aria-label="Low first response, minutes"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">s</span><input type="number" inputmode="numeric" min="0" max="59" name="first_response_s_low" value="0" aria-label="Low first response, seconds"></span>
    </div>
    <div class="sla-target">
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">h</span><input type="number" inputmode="numeric" min="0" name="resolve_h_low" value="72" aria-label="Low resolve, hours"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">m</span><input type="number" inputmode="numeric" min="0" max="59" name="resolve_m_low" value="0" aria-label="Low resolve, minutes"></span>
      <span class="sla-unit"><span class="sla-unit-mark" aria-hidden="true">s</span><input type="number" inputmode="numeric" min="0" max="59" name="resolve_s_low" value="0" aria-label="Low resolve, seconds"></span>
    </div>
  </div>

</div>
  <button class="btn primary" type="submit">Save SLA settings</button>
</form>
<form class="card form-card" method="post" action="/settings/calendar">
  <h2>Working calendar</h2>
  <p class="help">When the SLA clock runs. Frozen commitments keep their calendar.</p>
  <fieldset class="checkbox-field calendar-days">
    <legend>Working days</legend>
    <div class="calendar-day-list">

      <label class="calendar-day"><input type="checkbox" name="sla_calendar_days" value="1" checked> Monday</label>

      <label class="calendar-day"><input type="checkbox" name="sla_calendar_days" value="2" checked> Tuesday</label>

      <label class="calendar-day"><input type="checkbox" name="sla_calendar_days" value="3" checked> Wednesday</label>

      <label class="calendar-day"><input type="checkbox" name="sla_calendar_days" value="4" checked> Thursday</label>

      <label class="calendar-day"><input type="checkbox" name="sla_calendar_days" value="5" checked> Friday</label>

      <label class="calendar-day"><input type="checkbox" name="sla_calendar_days" value="6"> Saturday</label>

      <label class="calendar-day"><input type="checkbox" name="sla_calendar_days" value="7"> Sunday</label>

    </div>
    <p class="help">At least one day.</p>
  </fieldset>
  <div class="field-row">
    <div class="field">
      <label for="sla_calendar_start">Start</label>
      <input type="time" id="sla_calendar_start" name="sla_calendar_start" value="09:00" step="60">
    </div>
    <div class="field">
      <label for="sla_calendar_end">End</label>
      <input type="time" id="sla_calendar_end" name="sla_calendar_end" value="18:00" step="60">
    </div>
  </div>
  <div class="field">
    <label for="sla_calendar_timezone">Timezone</label>
    <input type="text" id="sla_calendar_timezone" name="sla_calendar_timezone" value="UTC" spellcheck="false" autocapitalize="off">
    <p class="help">IANA name, e.g. America/Argentina/Buenos_Aires. Defaults to UTC.</p>
  </div>
  <button class="btn primary" type="submit">Save working calendar</button>
</form>
</main>
</div>
</body>
</html>
