<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="htmx-config" content='{"refreshOnHistoryMiss":true}'>
<title>Category workflow · Help desk</title>

<link rel="stylesheet" href="/static/users.css"><script src="/static/workflow.js" defer></script><script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script><script src="/static/notifications.js" defer></script><script src="/static/shell.js" defer></script>
</head>
<body class="users-page-body ">
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="shell">
  <aside class="sidebar" id="sidebar" aria-label="Sidebar">
    <div class="sidebar-brand">
      <a class="brand-mark" href="/tickets" aria-label=""></a>
      <a class="brand-text" href="/tickets" tabindex="-1" aria-hidden="true"><span class="brand-name"></span><span class="brand-product"></span></a>
      <button class="sidebar-close" type="button" data-sidebar-close aria-label="Close menu">×</button>
    </div>
    <nav class="sidebar-nav" aria-label="Sections">
      <div class="sidebar-group">
        <span class="sidebar-group-label">Work</span>
        <a class="sidebar-link" href="/tickets" data-tip="Tickets">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
          <span class="sidebar-label">Tickets</span>
        </a>
      </div>
      <div class="sidebar-group">
        <span class="sidebar-group-label">Administration</span>
        <a class="sidebar-link" href="/users" data-tip="Users">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17.5" cy="9" r="2.5"/><path d="M16 14.6a6 6 0 0 1 5.5 5.4"/></svg>
          <span class="sidebar-label">Users</span>
        </a>
        <a class="sidebar-link active" href="/categories" data-tip="Catalog" aria-current="page">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h6l2 2.5H20a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/></svg>
          <span class="sidebar-label">Catalog</span>
        </a>
      </div>
    </nav>
    <div class="sidebar-foot">
      <button class="sidebar-collapse" type="button" data-sidebar-collapse aria-pressed="false" data-tip="Expand sidebar" data-label-collapse="Collapse sidebar" data-label-expand="Expand sidebar" aria-keyshortcuts="[">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 7l-5 5 5 5"/><path d="M18 7l-5 5 5 5"/></svg>
        <span class="sidebar-label">Collapse sidebar</span>
      </button>
      <div class="sidebar-user">
        <button class="sidebar-user-button" type="button" data-user-menu-toggle aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" data-tip="Ana Torres">
          <span class="sidebar-avatar" aria-hidden="true">AT</span>
          <span class="sidebar-label sidebar-user-text"><span class="sidebar-user-name">Ana Torres</span><span class="sidebar-user-role">Admin</span></span>
          <svg class="sidebar-user-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 14l6-6 6 6"/></svg>
        </button>
        <div class="user-menu" id="user-menu" role="menu" aria-label="Ana Torres" hidden>
          <a class="user-menu-item" role="menuitem" href="/preferences">Preferences</a>
          <form class="user-menu-logout" method="post" action="/logout">
            <button class="user-menu-item" role="menuitem" type="submit">Log out</button>
          </form>
        </div>
      </div>
    </div>
  </aside>
  <div class="sidebar-scrim" data-sidebar-close hidden></div>
  <div class="shell-body">
    <header class="topbar">
      <button class="topbar-menu" type="button" data-sidebar-open aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
      </button>
      <span class="topbar-section" aria-hidden="true">Catalog</span>
      <div class="topbar-spacer"></div>
      <div class="topbar-notifications" id="notification-bell" hx-get="/notifications/count" hx-trigger="load, every 45s [document.visibilityState === 'visible'], notifications:changed from:body" hx-target="this" hx-swap="innerHTML"><a class="bell-link" id="notification-bell-link" href="/notifications" hx-get="/notifications" hx-target="#notification-panel-host" hx-swap="innerHTML" title="Notifications" aria-label="Notifications">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
</a></div>
      <a class="btn primary topbar-new" href="/tickets/new">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        <span class="topbar-new-label">New ticket</span>
      </a>
    </header>
    <main class="main" id="main-content">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>

<div class="page-foundation category-workflow-page" hx-on::before-request="if(event.target.matches('.workflow-step-card-link')){var rail=this.querySelector('.workflow-step-rail');if(rail)this.dataset.workflowRailScrollTop=rail.scrollTop;this.dataset.workflowBuilderFocus='card'};if(event.target.matches('.workflow-step-menu-actions button'))this.dataset.workflowBuilderFocus='menu';if(event.target.matches('.workflow-add-options button')){this.dataset.workflowBuilderFocus='add'}" hx-on::after-swap="if(event.target.id==='workflow-builder'){var focusMode=this.dataset.workflowBuilderFocus,rail=this.querySelector('.workflow-step-rail');delete this.dataset.workflowBuilderFocus;if(focusMode==='card'&&rail){rail.scrollTop=Number(this.dataset.workflowRailScrollTop||0);delete this.dataset.workflowRailScrollTop};if(focusMode){var control=this.querySelector('.workflow-step-card.selected .workflow-step-card-link')||this.querySelector('.workflow-add-step summary,.workflow-add-step button');if(control){if(focusMode==='add')control.scrollIntoView({block:'nearest'});control.focus({preventScroll:true})}}}">
  <header class="page-header">
    <div>
      <nav class="page-breadcrumb" aria-label="Breadcrumb"><a href="/categories">Catalog</a><span aria-hidden="true"> / </span><span></span></nav>
      <h1 class="page-title">Category workflow</h1>
      <p class="page-subtitle">Build one ordered path for this category.</p>
    </div>
    <div class="page-actions">
      <button class="page-action" type="submit" form="workflow-form" name="action" value="save">Save</button>
      <button class="page-action page-action-primary" type="submit" form="workflow-form" name="action" value="publish">Publish</button>
    </div>
  </header>

<section id="workflow-builder" class="workflow-builder page-panel" aria-labelledby="workflow-builder-title" hx-on::before-swap="if(event.detail.xhr.status === 422 || event.detail.xhr.status === 409){event.detail.shouldSwap = true; event.detail.isError = false}">
  <div class="workflow-builder-head">
    <p>Select a step to configure it. Drag to reorder.</p>
    <span class="htmx-indicator spinner" aria-hidden="true"></span>
  </div>

  <div class="workflow-version-bar">
    <p class="workflow-live" role="status" aria-live="polite" data-workflow-live>Use Up and Down to change a step position.</p>
  </div>
  <form method="post" action="/categories/1/workflow" id="workflow-form" hx-post="/categories/1/workflow" hx-target="#workflow-builder" hx-swap="outerHTML" hx-sync="this:queue last" hx-indicator="#workflow-form" hx-on::before-request="this.setAttribute('aria-busy','true')" hx-on::after-request="this.removeAttribute('aria-busy')"><input type="hidden" name="selected_step_index" value="0">
    <input type="hidden" name="draft_revision" value="0">
    <input type="hidden" name="source_index" value=""><input type="hidden" name="target_index" value=""><button class="visually-hidden" type="submit" name="action" value="reorder" data-workflow-reorder aria-hidden="true" tabindex="-1" formaction="/categories/1/workflow" hx-post="/categories/1/workflow" hx-target="#workflow-builder" hx-swap="outerHTML" hx-include="closest form">Reorder</button>

    <div class="workflow-builder-panels">
      <div class="workflow-rail-wrap">
        <div class="workflow-pane-label"><h2 id="workflow-builder-title">Workflow steps</h2><span class="workflow-pane-count">0 steps</span></div>
        <ol class="workflow-step-rail" aria-label="Workflow steps"><li class="empty compact">No steps yet. Add a step to begin configuration.</li><li class="workflow-add-step">
<details class="workflow-add-popover"><summary class="btn ghost">+ Add step</summary><div class="workflow-add-options">
  <button type="submit" name="action" value="add_step" formaction="/categories/1/workflow?add_step_type=manual_task" hx-post="/categories/1/workflow?add_step_type=manual_task" hx-include="closest form" hx-target="#workflow-builder" hx-swap="outerHTML show:none" hx-push-url="false">Give the agent a task</button>
  <button type="submit" name="action" value="add_step" formaction="/categories/1/workflow?add_step_type=assign_to_desk" hx-post="/categories/1/workflow?add_step_type=assign_to_desk" hx-include="closest form" hx-target="#workflow-builder" hx-swap="outerHTML show:none" hx-push-url="false">Send to a desk</button>
  <button type="submit" name="action" value="add_step" formaction="/categories/1/workflow?add_step_type=form" hx-post="/categories/1/workflow?add_step_type=form" hx-include="closest form" hx-target="#workflow-builder" hx-swap="outerHTML show:none" hx-push-url="false">Ask for information</button>
  <button type="submit" name="action" value="add_step" formaction="/categories/1/workflow?add_step_type=resolve_ticket" hx-post="/categories/1/workflow?add_step_type=resolve_ticket" hx-include="closest form" hx-target="#workflow-builder" hx-swap="outerHTML show:none" hx-push-url="false">Mark the ticket resolved</button>
  <button type="submit" name="action" value="add_step" formaction="/categories/1/workflow?add_step_type=close_ticket" hx-post="/categories/1/workflow?add_step_type=close_ticket" hx-include="closest form" hx-target="#workflow-builder" hx-swap="outerHTML show:none" hx-push-url="false">Close the ticket</button>
</div></details>
</li>
        </ol>
      </div>    </div>
  </form>
    <dialog id="workflow-remove-step-dialog" data-workflow-remove-dialog aria-labelledby="workflow-remove-step-title" aria-describedby="workflow-remove-step-copy">
      <h2 id="workflow-remove-step-title">Remove this step?</h2>
      <p id="workflow-remove-step-copy">The step and its fields will be removed from the workflow.</p>
      <div>
        <button type="button" data-workflow-remove-cancel>Cancel</button>
        <button type="button" data-workflow-remove-confirm>Remove step</button>
      </div>
    </dialog>
    <dialog id="workflow-remove-field-dialog" data-workflow-remove-dialog aria-labelledby="workflow-remove-field-title" aria-describedby="workflow-remove-field-copy">
      <h2 id="workflow-remove-field-title">Remove this field?</h2>
      <p id="workflow-remove-field-copy">The field will be removed from this step.</p>
      <div>
        <button type="button" data-workflow-remove-cancel>Cancel</button>
        <button type="button" data-workflow-remove-confirm>Remove field</button>
      </div>
    </dialog>
</section>

      <dialog id="workflow-dirty-dialog" aria-labelledby="workflow-dirty-dialog-title" aria-describedby="workflow-dirty-dialog-copy">
        <h2 id="workflow-dirty-dialog-title">Save your workflow changes?</h2>
        <p id="workflow-dirty-dialog-copy">This structural action needs a decision about your unsaved workflow edits.</p>
        <div>
          <button type="button" data-workflow-save-continue>Save and continue</button>
          <button type="button" data-workflow-discard-continue>Discard and continue</button>
          <button type="button" data-workflow-cancel>Cancel</button>
        </div>
      </dialog>
      <dialog id="workflow-leave-dialog" aria-labelledby="workflow-leave-dialog-title" aria-describedby="workflow-leave-dialog-copy">
        <h2 id="workflow-leave-dialog-title">Leave without saving?</h2>
        <p id="workflow-leave-dialog-copy">Your workflow edits have not been saved yet.</p>
        <div>
          <button type="button" data-workflow-leave-stay>Stay</button>
          <button type="button" data-workflow-leave-discard>Discard changes</button>
        </div>
      </dialog>
    </div>
</main>
    <nav class="tabbar" aria-label="Sections">
      <a class="tabbar-item" href="/tickets">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
        <span>Tickets</span>
      </a>
      <a class="tabbar-item" href="/notifications">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
        <span>Notifications</span>
      </a>
      <a class="tabbar-item active" href="/categories" aria-current="page">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h6l2 2.5H20a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/></svg>
        <span>Catalog</span>
      </a>
      <button class="tabbar-item" type="button" data-sidebar-open aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
        <span>More</span>
      </button>
    </nav>
  </div>
  <div class="notification-panel-host" id="notification-panel-host"></div>
</div>
</body>
</html>
