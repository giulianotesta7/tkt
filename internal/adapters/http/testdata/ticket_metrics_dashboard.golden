<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="htmx-config" content='{"refreshOnHistoryMiss":true}'>
<title>Ticket metrics · Help desk</title>

<link rel="stylesheet" href="/static/users.css"><link rel="stylesheet" href="/static/ticket_metrics.css"><script src="/static/ticket_metrics.js" defer></script><script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script><script src="/static/notifications.js" defer></script><script src="/static/shell.js" defer></script>
</head>
<body class="users-page-body ">
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="shell">
  <aside class="sidebar" id="sidebar" aria-label="Sidebar">
    <div class="sidebar-brand">
      <a class="brand-mark" href="/tickets" aria-label=""></a>
      <a class="brand-text" href="/tickets" tabindex="-1" aria-hidden="true"><span class="brand-name"></span><span class="brand-product"></span></a>
      <button class="sidebar-close" type="button" data-sidebar-close aria-label="Close menu">×</button>
    </div>
    <nav class="sidebar-nav" aria-label="Sections">
      <div class="sidebar-group">
        <span class="sidebar-group-label">Work</span>
        <a class="sidebar-link" href="/tickets" data-tip="Tickets">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
          <span class="sidebar-label">Tickets</span>
        </a>
      </div>
    </nav>
    <div class="sidebar-foot">
      <button class="sidebar-collapse" type="button" data-sidebar-collapse aria-pressed="false" data-tip="Expand sidebar" data-label-collapse="Collapse sidebar" data-label-expand="Expand sidebar" aria-keyshortcuts="[">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 7l-5 5 5 5"/><path d="M18 7l-5 5 5 5"/></svg>
        <span class="sidebar-label">Collapse sidebar</span>
      </button>
      <div class="sidebar-user">
        <button class="sidebar-user-button" type="button" data-user-menu-toggle aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" data-tip="">
          <span class="sidebar-avatar" aria-hidden="true">?</span>
          <span class="sidebar-label sidebar-user-text"><span class="sidebar-user-name"></span><span class="sidebar-user-role"></span></span>
          <svg class="sidebar-user-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 14l6-6 6 6"/></svg>
        </button>
        <div class="user-menu" id="user-menu" role="menu" aria-label="" hidden>
          <a class="user-menu-item" role="menuitem" href="/preferences">Preferences</a>
          <form class="user-menu-logout" method="post" action="/logout">
            <button class="user-menu-item" role="menuitem" type="submit">Log out</button>
          </form>
        </div>
      </div>
    </div>
  </aside>
  <div class="sidebar-scrim" data-sidebar-close hidden></div>
  <div class="shell-body">
    <header class="topbar">
      <button class="topbar-menu" type="button" data-sidebar-open aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
      </button>
      <span class="topbar-section" aria-hidden="true">Metrics</span>
      <div class="topbar-spacer"></div>
      <div class="topbar-notifications" id="notification-bell" hx-get="/notifications/count" hx-trigger="load, every 45s [document.visibilityState === 'visible'], notifications:changed from:body" hx-target="this" hx-swap="innerHTML"><a class="bell-link" id="notification-bell-link" href="/notifications" hx-get="/notifications" hx-target="#notification-panel-host" hx-swap="innerHTML" title="Notifications" aria-label="Notifications">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
</a></div>
      <a class="btn primary topbar-new" href="/tickets/new">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        <span class="topbar-new-label">New ticket</span>
      </a>
    </header>
    <main class="main" id="main-content">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>
<div id="ticket-metrics-detail-content" class="ticket-metrics-detail">
  <header class="page-header ticket-metrics-detail-header"><div><nav class="page-breadcrumb" aria-label="Back to tickets"><a href="/tickets">Tickets</a><span aria-hidden="true"> / </span><span>Ticket metrics</span></nav><h1 class="page-title">Ticket metrics</h1></div><div class="page-actions"><a class="btn ghost" href="/tickets">Back to tickets</a></div></header>
  
  <form class="ticket-metrics-filters" id="ticket-metrics-filters" hx-get="/tickets/metrics" hx-target="#ticket-metrics-detail-content" hx-swap="outerHTML" hx-push-url="false" aria-label="Metric filters"><input type="hidden" name="return" value="/tickets"><label>From <input type="date" name="metrics_start" value="2026-09-02"></label><label>To <input type="date" name="metrics_end" value="2026-09-20"></label><label>Desk <select name="metrics_desk_id"><option value="">All desks</option><option value="1" >Service desk</option></select></label><label>Agent <select name="metrics_agent_id"><option value="">All agents</option><option value="1" >Ana Torres</option></select></label><button class="btn" type="submit">Apply</button><a class="btn ghost" href="/tickets/metrics?return=%2Ftickets">Clear</a><span class="htmx-indicator ticket-metrics-loading" aria-live="polite">Loading metrics</span></form>
  <p class="ticket-metrics-note">Timezone: UTC · Created and resolved: selected period · Pending workload: current</p>
  <div id="ticket-metrics-cards" class="ticket-metrics-cards ticket-metrics-kpis">
  <div class="ticket-metrics-card"><span class="ticket-metrics-card-label">Pending</span><span class="ticket-metrics-card-value">4</span><span class="ticket-metrics-card-detail">1 unassigned · 25% of pending</span></div>
  <div class="ticket-metrics-card"><span class="ticket-metrics-card-label">Created</span><span class="ticket-metrics-card-value">9</span><span class="ticket-metrics-card-detail">3 weeks in the period</span></div>
  <div class="ticket-metrics-card"><span class="ticket-metrics-card-label">Resolved</span><span class="ticket-metrics-card-value">6</span><span class="ticket-metrics-card-detail">net &#43;3</span></div>
  <div class="ticket-metrics-card"><span class="ticket-metrics-card-label">Mean resolution</span><span class="ticket-metrics-card-value">1.8 days</span><span class="ticket-metrics-card-detail">median 1.2 days · p90 5.0 days</span></div>
  <div class="ticket-metrics-card"><span class="ticket-metrics-card-label">SLA · first response</span><span class="ticket-metrics-card-value">75%</span><span class="ticket-metrics-card-detail">4 decided · resolution 50%</span></div>
</div><div class="ticket-metrics-grid">
    <section class="ticket-metrics-card ticket-metrics-panel" data-metrics-section><div class="ticket-metrics-panel-head"><h2>Created vs resolved</h2><div class="ticket-metrics-view" role="group" aria-label="View data"><button type="button" class="ticket-metrics-view-btn" data-metrics-view="chart" aria-pressed="true">Chart</button><button type="button" class="ticket-metrics-view-btn" data-metrics-view="table" aria-pressed="false">Table</button></div></div><div class="ticket-metrics-scope-row"><p class="ticket-metrics-card-scope">Weekly events within the selected period</p><div class="ticket-metrics-legend" aria-label="Created and resolved series legend"><span class="ticket-metrics-legend-item"><span class="ticket-metrics-legend-line metrics-legend-created" aria-hidden="true"></span>Created</span><span class="ticket-metrics-legend-item"><span class="ticket-metrics-legend-line metrics-legend-resolved" aria-hidden="true"></span>Resolved</span></div></div>
    <div class="ticket-metrics-view-chart" data-metrics-panel="chart"><svg class="ticket-metrics-chart" viewBox="0 0 620 204" role="img" aria-label="Weekly created tickets as a continuous line with circle markers and resolved tickets as a dashed line with square markers. Y axis from 0 to 6. Y axis title Tickets."><text x="10" y="93.0" transform="rotate(-90 10 93.0)" text-anchor="middle" class="metrics-axis-title">Tickets</text><line x1="46" y1="164" x2="608" y2="164" class="metrics-axis"/><line x1="46" y1="116.7" x2="608" y2="116.7" class="metrics-gridline"/><line x1="46" y1="69.3" x2="608" y2="69.3" class="metrics-gridline"/><line x1="46" y1="22.0" x2="608" y2="22.0" class="metrics-gridline"/><text x="40" y="167.5" text-anchor="end" class="metrics-axis-label">0</text><text x="40" y="120.2" text-anchor="end" class="metrics-axis-label">2</text><text x="40" y="72.8" text-anchor="end" class="metrics-axis-label">4</text><text x="40" y="25.5" text-anchor="end" class="metrics-axis-label">6</text><polyline class="metrics-line metrics-created" points="46.0,140.3 327.0,45.7 608.0,93.0 "/><polyline class="metrics-line metrics-resolved" points="46.0,164.0 327.0,93.0 608.0,93.0 "/><circle cx="46.0" cy="140.3" r="3.5" class="metrics-marker metrics-marker-created"/><rect x="42.5" y="160.5" width="7" height="7" class="metrics-marker metrics-marker-resolved"/><text x="46.0" y="196" class="metrics-chart-label">Aug 31*</text><text x="46.0" y="133.3" text-anchor="middle" class="metrics-chart-value metrics-chart-value-created">1</text><circle cx="327.0" cy="45.7" r="3.5" class="metrics-marker metrics-marker-created"/><rect x="323.5" y="89.5" width="7" height="7" class="metrics-marker metrics-marker-resolved"/><text x="327.0" y="196" class="metrics-chart-label">Sep 7</text><text x="327.0" y="38.7" text-anchor="middle" class="metrics-chart-value metrics-chart-value-created">5</text><text x="327.0" y="86.0" text-anchor="middle" class="metrics-chart-value metrics-chart-value-resolved">3</text><circle cx="608.0" cy="93.0" r="3.5" class="metrics-marker metrics-marker-created"/><rect x="604.5" y="89.5" width="7" height="7" class="metrics-marker metrics-marker-resolved"/><text x="608.0" y="196" class="metrics-chart-label">Sep 14</text><text x="608.0" y="86.0" text-anchor="middle" class="metrics-chart-value metrics-chart-value-created">3</text><text x="608.0" y="109.0" text-anchor="middle" class="metrics-chart-value metrics-chart-value-resolved">3</text></svg><p class="ticket-metrics-chart-totals">Created 9 · Resolved 6</p>
    <p class="ticket-metrics-note ticket-metrics-partial-note">* Partial week: the selected period does not cover the full Monday–Sunday week.</p>
    </div>
    <div class="ticket-metrics-view-table" data-metrics-panel="table" hidden><div class="ticket-metrics-table-wrap"><table><caption>Weekly ticket totals</caption><thead><tr><th scope="col">Monday week</th><th scope="col">Created</th><th scope="col">Resolved</th></tr></thead><tbody><tr><td>2026-08-31</td><td>1</td><td>0</td></tr><tr><td>2026-09-07</td><td>5</td><td>3</td></tr><tr><td>2026-09-14</td><td>3</td><td>3</td></tr></tbody></table></div></div></section>
    <section class="ticket-metrics-card ticket-metrics-panel" data-metrics-section><div class="ticket-metrics-panel-head"><h2>Age of pending tickets</h2><div class="ticket-metrics-view" role="group" aria-label="View data"><button type="button" class="ticket-metrics-view-btn" data-metrics-view="chart" aria-pressed="true">Chart</button><button type="button" class="ticket-metrics-view-btn" data-metrics-view="table" aria-pressed="false">Table</button></div></div><div class="ticket-metrics-scope-row"><p class="ticket-metrics-card-scope">Current pending workload · Time since creation</p></div>
    <div class="ticket-metrics-view-chart" data-metrics-panel="chart"><svg class="ticket-metrics-chart ticket-metrics-bars" viewBox="0 0 620 188" role="img" aria-label="Pending tickets by completed elapsed age. X axis from 0 to 2. X axis title Pending tickets."><line x1="362.0" y1="14" x2="362.0" y2="134.0" class="metrics-gridline"/><line x1="604.0" y1="14" x2="604.0" y2="134.0" class="metrics-gridline"/><line x1="120" y1="14" x2="120" y2="134.0" class="metrics-axis"/><line x1="120" y1="134.0" x2="604" y2="134.0" class="metrics-axis"/><text x="120.0" y="150.0" text-anchor="middle" class="metrics-axis-label">0</text><text x="362.0" y="150.0" text-anchor="middle" class="metrics-axis-label">1</text><text x="604.0" y="150.0" text-anchor="middle" class="metrics-axis-label">2</text><text x="362.0" y="168.0" text-anchor="middle" class="metrics-axis-title">Pending tickets</text><text x="2" y="34" class="metrics-chart-label">0–2 days</text><rect x="120" y="20" width="484.0" height="18" class="metrics-bar"/><text x="610.0" y="34" class="metrics-chart-value">2</text><text x="2" y="64" class="metrics-chart-label">3–7 days</text><rect x="120" y="50" width="242.0" height="18" class="metrics-bar"/><text x="368.0" y="64" class="metrics-chart-value">1</text><text x="2" y="94" class="metrics-chart-label">8–14 days</text><rect x="120" y="80" width="0.0" height="18" class="metrics-bar"/><text x="126.0" y="94" class="metrics-chart-value">0</text><text x="2" y="124" class="metrics-chart-label">&gt;14 days</text><rect x="120" y="110" width="242.0" height="18" class="metrics-bar"/><text x="368.0" y="124" class="metrics-chart-value">1</text></svg>
    </div>
    <div class="ticket-metrics-view-table" data-metrics-panel="table" hidden><div class="ticket-metrics-table-wrap"><table><caption>Pending tickets by completed elapsed days</caption><thead><tr><th scope="col">Elapsed age</th><th scope="col">Tickets</th></tr></thead><tbody><tr><td>0–2 days</td><td>2</td></tr><tr><td>3–7 days</td><td>1</td></tr><tr><td>8–14 days</td><td>0</td></tr><tr><td>&gt;14 days</td><td>1</td></tr></tbody></table></div></div></section>
    <section class="ticket-metrics-card ticket-metrics-panel" data-metrics-section><div class="ticket-metrics-panel-head"><h2>Pending workload</h2><div class="ticket-metrics-view" role="group" aria-label="View data"><button type="button" class="ticket-metrics-view-btn" data-metrics-view="chart" aria-pressed="true">Chart</button><button type="button" class="ticket-metrics-view-btn" data-metrics-view="table" aria-pressed="false">Table</button></div></div>
      <div class="ticket-metrics-scope-row"><p class="ticket-metrics-card-scope">Current assignment · 4 pending tickets</p><fieldset class="ticket-metrics-group"><legend class="ticket-metrics-visually-hidden">Workload grouping</legend><label><input type="radio" name="metrics_group" value="agent" hx-get="/tickets/metrics" hx-include="#ticket-metrics-filters" hx-target="#ticket-metrics-detail-content" hx-swap="outerHTML" form="ticket-metrics-filters" checked>By agent</label><label><input type="radio" name="metrics_group" value="desk" hx-get="/tickets/metrics" hx-include="#ticket-metrics-filters" hx-target="#ticket-metrics-detail-content" hx-swap="outerHTML" form="ticket-metrics-filters" >By desk</label></fieldset></div>
      <div class="ticket-metrics-view-chart" data-metrics-panel="chart"><svg class="ticket-metrics-chart ticket-metrics-bars" viewBox="0 0 620 144" role="img" aria-label="Pending workload. X axis from 0 to 2. X axis title Pending tickets."><line x1="390.0" y1="6" x2="390.0" y2="90.0" class="metrics-gridline"/><line x1="604.0" y1="6" x2="604.0" y2="90.0" class="metrics-gridline"/><line x1="176" y1="6" x2="176" y2="90.0" class="metrics-axis"/><line x1="176" y1="90.0" x2="604" y2="90.0" class="metrics-axis"/><text x="176.0" y="106.0" text-anchor="middle" class="metrics-axis-label">0</text><text x="390.0" y="106.0" text-anchor="middle" class="metrics-axis-label">1</text><text x="604.0" y="106.0" text-anchor="middle" class="metrics-axis-label">2</text><text x="390.0" y="124.0" text-anchor="middle" class="metrics-axis-title">Pending tickets</text><text x="2" y="26" class="metrics-chart-label">Ana Torres</text><rect x="176" y="12" width="428.0" height="18" class="metrics-bar"/><text x="610.0" y="26" class="metrics-chart-value">2</text><text x="2" y="54" class="metrics-chart-label">Unassigned</text><rect x="176" y="40" width="214.0" height="18" class="metrics-bar metrics-bar-unassigned"/><text x="396.0" y="54" class="metrics-chart-value">1</text><text x="2" y="82" class="metrics-chart-label">Zoe Chen</text><rect x="176" y="68" width="214.0" height="18" class="metrics-bar"/><text x="396.0" y="82" class="metrics-chart-value">1</text></svg>
      </div>
      <div class="ticket-metrics-view-table" data-metrics-panel="table" hidden><div class="ticket-metrics-table-wrap"><table><caption>Pending workload by current agent</caption><thead><tr><th scope="col">Current agent</th><th scope="col">Pending</th></tr></thead><tbody><tr><td>Ana Torres</td><td>2</td></tr><tr><td>Unassigned</td><td>1</td></tr><tr><td>Zoe Chen</td><td>1</td></tr></tbody></table></div></div></section>
    <section class="ticket-metrics-card ticket-metrics-panel" data-metrics-section><div class="ticket-metrics-panel-head"><h2>Resolution time distribution</h2><div class="ticket-metrics-view" role="group" aria-label="View data"><button type="button" class="ticket-metrics-view-btn" data-metrics-view="chart" aria-pressed="true">Chart</button><button type="button" class="ticket-metrics-view-btn" data-metrics-view="table" aria-pressed="false">Table</button></div></div><div class="ticket-metrics-scope-row"><p class="ticket-metrics-card-scope">Resolved during the selected period</p></div>
    <div class="ticket-metrics-view-chart" data-metrics-panel="chart"><svg class="ticket-metrics-chart ticket-metrics-histogram" viewBox="0 0 620 200" role="img" aria-label="Resolved tickets by resolution duration in equal-width day bins. Y axis from 0 to 4. Y axis title Tickets. X axis title Resolution time (days)."><text x="10" y="80.0" transform="rotate(-90 10 80.0)" text-anchor="middle" class="metrics-axis-title">Tickets</text><line x1="46" y1="146.0" x2="606" y2="146.0" class="metrics-axis"/><line x1="46" y1="113.0" x2="606" y2="113.0" class="metrics-gridline"/><line x1="46" y1="80.0" x2="606" y2="80.0" class="metrics-gridline"/><line x1="46" y1="47.0" x2="606" y2="47.0" class="metrics-gridline"/><line x1="46" y1="14.0" x2="606" y2="14.0" class="metrics-gridline"/><text x="40" y="149.5" text-anchor="end" class="metrics-axis-label">0</text><text x="40" y="116.5" text-anchor="end" class="metrics-axis-label">1</text><text x="40" y="83.5" text-anchor="end" class="metrics-axis-label">2</text><text x="40" y="50.5" text-anchor="end" class="metrics-axis-label">3</text><text x="40" y="17.5" text-anchor="end" class="metrics-axis-label">4</text><rect x="46.0" y="14.0" width="280.0" height="132.0" class="metrics-hist-bar"/><rect x="326.0" y="113.0" width="280.0" height="33.0" class="metrics-hist-bar"/><text x="46.0" y="162.0" text-anchor="start" class="metrics-axis-label">0</text><text x="326.0" y="162.0" text-anchor="middle" class="metrics-axis-label">5</text><text x="606.0" y="162.0" text-anchor="end" class="metrics-axis-label">10</text><text x="326.0" y="180.0" text-anchor="middle" class="metrics-axis-title">Resolution time (days)</text></svg><p class="ticket-metrics-note">5 valid · 1 excluded</p>
    </div>
    <div class="ticket-metrics-view-table" data-metrics-panel="table" hidden><div class="ticket-metrics-table-wrap"><table><caption>Resolution duration histogram</caption><thead><tr><th scope="col">Elapsed duration (days)</th><th scope="col">Resolved tickets</th></tr></thead><tbody><tr><td>0–&lt;5 days</td><td>4</td></tr><tr><td>5–&lt;10 days</td><td>1</td></tr></tbody></table></div></div></section>
    <section class="ticket-metrics-card ticket-metrics-panel" data-metrics-section><div class="ticket-metrics-panel-head"><h2>SLA attainment</h2><div class="ticket-metrics-view" role="group" aria-label="View data"><button type="button" class="ticket-metrics-view-btn" data-metrics-view="chart" aria-pressed="true">Chart</button><button type="button" class="ticket-metrics-view-btn" data-metrics-view="table" aria-pressed="false">Table</button></div></div>
      <div class="ticket-metrics-scope-row"><p class="ticket-metrics-card-scope">Tickets created in the selected period that carry a frozen commitment</p><fieldset class="ticket-metrics-group"><legend class="ticket-metrics-visually-hidden">Attainment grouping</legend><label><input type="radio" name="metrics_attainment_group" value="total" hx-get="/tickets/metrics" hx-include="#ticket-metrics-filters" hx-target="#ticket-metrics-detail-content" hx-swap="outerHTML" form="ticket-metrics-filters" >Total</label><label><input type="radio" name="metrics_attainment_group" value="priority" hx-get="/tickets/metrics" hx-include="#ticket-metrics-filters" hx-target="#ticket-metrics-detail-content" hx-swap="outerHTML" form="ticket-metrics-filters" checked>By priority</label><label><input type="radio" name="metrics_attainment_group" value="category" hx-get="/tickets/metrics" hx-include="#ticket-metrics-filters" hx-target="#ticket-metrics-detail-content" hx-swap="outerHTML" form="ticket-metrics-filters" >By category</label></fieldset></div>
      <div class="ticket-metrics-view-chart" data-metrics-panel="chart"><div class="ticket-metrics-attainment"><div class="ticket-metrics-attainment-summary"><div class="ticket-metrics-attainment-milestone"><h3>First response</h3><p class="ticket-metrics-attainment-counts">Met 3 · Breached 1 · Open 1</p><p class="ticket-metrics-attainment-rate">Rate 75% (4 decided)</p></div><div class="ticket-metrics-attainment-milestone"><h3>Resolution</h3><p class="ticket-metrics-attainment-counts">Met 1 · Breached 1 · Open 3</p><p class="ticket-metrics-attainment-rate">Rate 50% (2 decided)</p></div></div><div class="ticket-metrics-legend" aria-label="SLA attainment state legend"><span class="ticket-metrics-legend-item"><span class="ticket-metrics-legend-swatch metrics-legend-met" aria-hidden="true"></span>Met</span><span class="ticket-metrics-legend-item"><span class="ticket-metrics-legend-swatch metrics-legend-breached" aria-hidden="true"></span>Breached</span><span class="ticket-metrics-legend-item"><span class="ticket-metrics-legend-swatch metrics-legend-open" aria-hidden="true"></span>Open</span></div><svg class="ticket-metrics-chart ticket-metrics-attainment" viewBox="0 0 620 106" role="img" aria-label="SLA attainment chart: first response and resolution rates per group. Critical: 2 tickets, first response 100%, resolution 50%. High: 3 tickets, first response 67%, resolution 0%. The table view holds the same values."><text x="0" y="20.0" class="metrics-chart-label metrics-att-group">Critical</text><text x="170.0" y="20.0" text-anchor="end" class="metrics-att-count">2 tickets</text><text x="150" y="33.0" class="metrics-att-tag">FR</text><rect x="178.0" y="26.0" width="390.0" height="8" rx="4" class="metrics-att-track"/><rect x="178.0" y="26.0" width="195.0" height="8" rx="4" class="metrics-att-bar metrics-att-met"/><rect x="373.0" y="26.0" width="195.0" height="8" rx="4" class="metrics-att-bar metrics-att-open"/><text x="576.0" y="33.0" class="metrics-chart-value metrics-att-rate">100%</text><text x="150" y="45.0" class="metrics-att-tag">Res</text><rect x="178.0" y="38.0" width="390.0" height="8" rx="4" class="metrics-att-track"/><rect x="178.0" y="38.0" width="195.0" height="8" rx="4" class="metrics-att-bar metrics-att-met"/><rect x="373.0" y="38.0" width="195.0" height="8" rx="4" class="metrics-att-bar metrics-att-breached"/><text x="576.0" y="45.0" class="metrics-chart-value metrics-att-rate">50%</text><text x="0" y="66.0" class="metrics-chart-label metrics-att-group">High</text><text x="170.0" y="66.0" text-anchor="end" class="metrics-att-count">3 tickets</text><text x="150" y="79.0" class="metrics-att-tag">FR</text><rect x="178.0" y="72.0" width="390.0" height="8" rx="4" class="metrics-att-track"/><rect x="178.0" y="72.0" width="260.0" height="8" rx="4" class="metrics-att-bar metrics-att-met"/><rect x="438.0" y="72.0" width="130.0" height="8" rx="4" class="metrics-att-bar metrics-att-breached"/><text x="576.0" y="79.0" class="metrics-chart-value metrics-att-rate">67%</text><text x="150" y="91.0" class="metrics-att-tag">Res</text><rect x="178.0" y="84.0" width="390.0" height="8" rx="4" class="metrics-att-track"/><rect x="178.0" y="84.0" width="390.0" height="8" rx="4" class="metrics-att-bar metrics-att-open"/><text x="576.0" y="91.0" class="metrics-chart-value metrics-att-rate">0%</text></svg></div>
      <p class="ticket-metrics-note">Tickets created in the period without a frozen commitment are excluded from these rates (1).</p>
      </div>
      <div class="ticket-metrics-view-table" data-metrics-panel="table" hidden><div class="ticket-metrics-table-wrap"><table><caption>SLA attainment by Priority</caption><thead><tr><th scope="col">Priority</th><th scope="col">Tickets</th><th scope="col">First response met</th><th scope="col">First response breached</th><th scope="col">First response open</th><th scope="col">First response rate</th><th scope="col">Resolution met</th><th scope="col">Resolution breached</th><th scope="col">Resolution open</th><th scope="col">Resolution rate</th></tr></thead><tbody><tr class="ticket-metrics-attainment-row"><td>Critical</td><td>2</td><td>1</td><td>0</td><td>1</td><td>100% (1 decided)</td><td>1</td><td>1</td><td>0</td><td>50% (2 decided)</td></tr><tr class="ticket-metrics-attainment-row"><td>High</td><td>3</td><td>2</td><td>1</td><td>0</td><td>67% (3 decided)</td><td>0</td><td>0</td><td>3</td><td>0% (0 decided)</td></tr></tbody></table></div>
      </div></section>
  </div>
</div></main>
