<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="htmx-config" content='{"refreshOnHistoryMiss":true}'>
<title>Settings · Help desk</title>

<link rel="stylesheet" href="/static/settings.css"><script src="/static/settings.js" defer></script><script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script><script src="/static/notifications.js" defer></script><script src="/static/shell.js" defer></script>
</head>
<body class="">
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="shell">
  <aside class="sidebar" id="sidebar" aria-label="Sidebar">
    <div class="sidebar-brand">
      <a class="brand-mark" href="/tickets" aria-label="tkt">T</a>
      <a class="brand-text" href="/tickets" tabindex="-1" aria-hidden="true"><span class="brand-name">tkt</span><span class="brand-product">Help desk</span></a>
      <button class="sidebar-close" type="button" data-sidebar-close aria-label="Close menu">×</button>
    </div>
    <nav class="sidebar-nav" aria-label="Sections">
      <div class="sidebar-group">
        <span class="sidebar-group-label">Work</span>
        <a class="sidebar-link" href="/tickets" data-tip="Tickets">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
          <span class="sidebar-label">Tickets</span>
        </a>
        <a class="sidebar-link" href="/tickets/metrics" data-tip="Metrics">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/></svg>
          <span class="sidebar-label">Metrics</span>
        </a>
      </div>
      <div class="sidebar-group">
        <span class="sidebar-group-label">Administration</span>
        <a class="sidebar-link" href="/users" data-tip="Users">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17.5" cy="9" r="2.5"/><path d="M16 14.6a6 6 0 0 1 5.5 5.4"/></svg>
          <span class="sidebar-label">Users</span>
        </a>
        <a class="sidebar-link active" href="/settings" data-tip="Settings" aria-current="page">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
          <span class="sidebar-label">Settings</span>
        </a>
      </div>
    </nav>
    <div class="sidebar-foot">
      <button class="sidebar-collapse" type="button" data-sidebar-collapse aria-pressed="false" data-tip="Expand sidebar" data-label-collapse="Collapse sidebar" data-label-expand="Expand sidebar" aria-keyshortcuts="[">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 7l-5 5 5 5"/><path d="M18 7l-5 5 5 5"/></svg>
        <span class="sidebar-label">Collapse sidebar</span>
      </button>
      <div class="sidebar-user">
        <button class="sidebar-user-button" type="button" data-user-menu-toggle aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" data-tip="Ana Torres">
          <span class="sidebar-avatar" aria-hidden="true">AT</span>
          <span class="sidebar-label sidebar-user-text"><span class="sidebar-user-name">Ana Torres</span><span class="sidebar-user-role"></span></span>
          <svg class="sidebar-user-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 14l6-6 6 6"/></svg>
        </button>
        <div class="user-menu" id="user-menu" role="menu" aria-label="Ana Torres" hidden>
          <a class="user-menu-item" role="menuitem" href="/preferences">Preferences</a>
          <form class="user-menu-logout" method="post" action="/logout">
            <button class="user-menu-item" role="menuitem" type="submit">Log out</button>
          </form>
        </div>
      </div>
    </div>
  </aside>
  <div class="sidebar-scrim" data-sidebar-close hidden></div>
  <div class="shell-body">
    <header class="topbar">
      <button class="topbar-menu" type="button" data-sidebar-open aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
      </button>
      <span class="topbar-section" aria-hidden="true">Settings</span>
      <div class="topbar-spacer"></div>
      <div class="topbar-notifications" id="notification-bell" hx-get="/notifications/count" hx-trigger="load, every 45s [document.visibilityState === 'visible'], notifications:changed from:body" hx-target="this" hx-swap="innerHTML"><a class="bell-link" id="notification-bell-link" href="/notifications" hx-get="/notifications" hx-target="#notification-panel-host" hx-swap="innerHTML" title="Notifications" aria-label="Notifications">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
</a></div>
      <a class="btn primary topbar-new" href="/tickets/new">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        <span class="topbar-new-label">New ticket</span>
      </a>
    </header>
    <main class="main" id="main-content">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>

<div class="command-header">
  <div>
    <h1 class="command-title">Settings</h1>
  </div>
</div>
<div class="settings-layout">

<nav class="settings-nav" aria-label="Settings sections">
  <a class="settings-nav-link" href="/settings/organization">Organization</a>
  <a class="settings-nav-link" href="/settings/signin" aria-current="page">Sign-in page</a>
  <a class="settings-nav-link" href="/settings/language">Language</a>
  <a class="settings-nav-link" href="/settings/tickets">Tickets &amp; SLA</a>
  <a class="settings-nav-link" href="/settings/email">Email notifications</a>
  <a class="settings-nav-link" href="/settings/security">Security</a>
  <a class="settings-nav-link" href="/settings/calendar">Working calendar</a>
</nav>

  <div class="settings-content">
    <div class="settings-signin">
      <form class="settings-form card form-card" method="post" action="/settings/signin" enctype="multipart/form-data" data-settings-form>
        <h2 class="settings-section-title">Sign-in page</h2>
        <div class="field">
          <label for="signin_title">Title</label><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about Title" aria-describedby="help-tip-signin-title" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-signin-title">Leave it empty to use the default text.</span></span>
          <input type="text" id="signin_title" name="title" value="Sistemas, a un pedido" maxlength="80" data-preview-title>
        </div>
        <div class="field">
          <label for="signin_subtitle">Subtitle</label>
          <input type="text" id="signin_subtitle" name="subtitle" value="Cargá tu pedido y seguí su estado." maxlength="200" data-preview-subtitle>
        </div>
        <h3 class="settings-group-title">Content</h3>
        <fieldset class="settings-segment">
          <legend class="visually-hidden">Content</legend>
          <label><input type="radio" name="content" value="steps">Steps</label>
          <label><input type="radio" name="content" value="highlights" checked>Highlights</label>
          <label><input type="radio" name="content" value="none">None</label>
        </fieldset>
        <div class="settings-highlights" data-show-when="content=highlights">
          <div class="settings-highlight" data-highlight-row="0">
            <div class="field">
              <label for="highlight_0_icon">Icon</label>
              <select id="highlight_0_icon" name="highlight_0_icon" data-preview-hl-icon="0">
                <option value="clock" selected>Clock</option>
                <option value="phone">Phone</option>
                <option value="check">Check</option>
                <option value="shield">Shield</option>
                <option value="chat">Chat</option>
                <option value="info">Info</option>
              </select>
            </div>
            <div class="field">
              <label for="highlight_0_title">Title</label>
              <input type="text" id="highlight_0_title" name="highlight_0_title" value="Primera respuesta en 4 h" maxlength="60" data-preview-hl-title="0">
            </div>
            <div class="field">
              <label for="highlight_0_text">Text</label>
              <input type="text" id="highlight_0_text" name="highlight_0_text" value="Los críticos en menos de 30 min." maxlength="120" data-preview-hl-text="0">
            </div>
            <button class="btn settings-highlight-remove" type="button" data-highlight-remove="0" aria-label="Remove highlight"><span aria-hidden="true">×</span></button>
          </div>
          <div class="settings-highlight" data-highlight-row="1">
            <div class="field">
              <label for="highlight_1_icon">Icon</label>
              <select id="highlight_1_icon" name="highlight_1_icon" data-preview-hl-icon="1">
                <option value="clock">Clock</option>
                <option value="phone" selected>Phone</option>
                <option value="check">Check</option>
                <option value="shield">Shield</option>
                <option value="chat">Chat</option>
                <option value="info">Info</option>
              </select>
            </div>
            <div class="field">
              <label for="highlight_1_title">Title</label>
              <input type="text" id="highlight_1_title" name="highlight_1_title" value="Guardia 24/7" maxlength="60" data-preview-hl-title="1">
            </div>
            <div class="field">
              <label for="highlight_1_text">Text</label>
              <input type="text" id="highlight_1_text" name="highlight_1_text" value="Interno 4400 fuera de horario." maxlength="120" data-preview-hl-text="1">
            </div>
            <button class="btn settings-highlight-remove" type="button" data-highlight-remove="1" aria-label="Remove highlight"><span aria-hidden="true">×</span></button>
          </div>
          <div class="settings-highlight" data-highlight-row="2">
            <div class="field">
              <label for="highlight_2_icon">Icon</label>
              <select id="highlight_2_icon" name="highlight_2_icon" data-preview-hl-icon="2">
                <option value="clock" selected>Clock</option>
                <option value="phone">Phone</option>
                <option value="check">Check</option>
                <option value="shield">Shield</option>
                <option value="chat">Chat</option>
                <option value="info">Info</option>
              </select>
            </div>
            <div class="field">
              <label for="highlight_2_title">Title</label>
              <input type="text" id="highlight_2_title" name="highlight_2_title" value="" maxlength="60" data-preview-hl-title="2">
            </div>
            <div class="field">
              <label for="highlight_2_text">Text</label>
              <input type="text" id="highlight_2_text" name="highlight_2_text" value="" maxlength="120" data-preview-hl-text="2">
            </div>
            <button class="btn settings-highlight-remove" type="button" data-highlight-remove="2" aria-label="Remove highlight"><span aria-hidden="true">×</span></button>
          </div>
          <template data-icon-template="clock"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg></template>
          <template data-icon-template="phone"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4h3l2 5-2 1a10 10 0 0 0 5 5l1-2 5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 4 6a2 2 0 0 1 2-2z"/></svg></template>
          <template data-icon-template="check"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg></template>
          <template data-icon-template="shield"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/></svg></template>
          <template data-icon-template="chat"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4V5z"/></svg></template>
          <template data-icon-template="info"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 11v6"/><path d="M12 7.5v.5"/></svg></template>
          <button class="btn" type="button" data-highlight-add>Add highlight</button>
        </div>
        <h3 class="settings-group-title">Notice</h3>
        <div class="field checkbox-field">
          <label><input type="checkbox" name="notice_enabled" value="1" checked data-preview-notice-toggle> Show a notice</label>
        </div>
        <div class="settings-reveal" data-show-when="notice_enabled=checked">
        <fieldset class="settings-segment">
          <legend class="visually-hidden">Type</legend>
          <label><input type="radio" name="notice_kind" value="info">Info</label>
          <label><input type="radio" name="notice_kind" value="warning" checked>Warning</label>
        </fieldset>
        <div class="field">
          <label for="signin_notice_title">Title</label>
          <input type="text" id="signin_notice_title" name="notice_title" value="Mantenimiento programado" maxlength="80" data-preview-notice-title>
        </div>
        <div class="field">
          <label for="signin_notice_text">Text</label>
          <input type="text" id="signin_notice_text" name="notice_text" value="El sábado de 10 a 12." maxlength="240" data-preview-notice-text>
        </div>
        </div>
        <h3 class="settings-group-title">Background</h3>
        <fieldset class="settings-segment">
          <legend class="visually-hidden">Background</legend>
          <label><input type="radio" name="background" value="dark">Dark</label>
          <label><input type="radio" name="background" value="brand" checked>Brand color</label>
          <label><input type="radio" name="background" value="image">Image</label>
        </fieldset>
        <div class="field" data-show-when="background=brand">
          <label for="signin_brand_color">Brand color</label>
          <input type="color" id="signin_brand_color" name="brand_color" value="#C8102E" data-preview-brand>
        </div>
        <div class="field" data-show-when="background=image" hidden>
          <label for="signin_background">Background image</label><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about Background image" aria-describedby="help-tip-signin-image" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-signin-image">1600 × 1800 px recommended. Smaller screens crop the edges, so keep the subject centered. PNG or JPEG, up to 1 MiB; a dark overlay keeps the text readable.</span></span>
          <div class="settings-logo">
            <span class="settings-logo-mark"><img src="/brand/signin-background?v=0123456789ab" alt="" width="48" height="48"></span>
            <div class="settings-logo-controls">
              <input type="file" id="signin_background" name="background" accept="image/png,image/jpeg">
              <button class="btn" type="submit" form="signin-background-remove">Remove image</button>
            </div>
          </div>
        </div>
        <h3 class="settings-group-title">Support contact</h3>
        <div class="field-row">
          <div class="field">
            <label for="signin_support_phone">Phone</label>
            <input type="text" id="signin_support_phone" name="support_phone" value="Interno 4400" maxlength="40" data-preview-phone>
          </div>
          <div class="field">
            <label for="signin_support_hours">Hours</label>
            <input type="text" id="signin_support_hours" name="support_hours" value="Lun a vie, 8 a 18" maxlength="60" data-preview-hours>
          </div>
        </div>
        <div class="settings-savebar" data-settings-savebar hidden>
          <button class="btn primary" type="submit">Save sign-in page</button>
          <button class="btn" type="reset">Discard</button>
        </div>
      </form>
      <form id="signin-background-remove" method="post" action="/settings/signin/background/remove"></form>
      <aside class="settings-preview" aria-label="Preview">
        <b class="settings-preview-label">Preview</b>
        <div class="settings-preview-frame" data-clip-exempt>
          <div class="settings-preview-scale">
            <div class="auth-entry__presentation auth-entry__presentation--brand" style="--signin-brand:#C8102E" data-preview-panel>
              <div class="auth-entry__brand">
                <span class="auth-entry__mark" aria-hidden="true">T</span>
                <div class="auth-entry__brand-text"><b>tkt</b><span>Help desk</span></div>
              </div>
              <div class="auth-entry__body">
                <div class="auth-entry__notice auth-entry__notice--warning" data-preview-notice><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4l9 16H3l9-16z"/><path d="M12 10v4"/><path d="M12 17v.5"/></svg><div><b data-preview-notice-title-text>Mantenimiento programado</b><span data-preview-notice-body-text>El sábado de 10 a 12.</span></div></div>
                <h2 data-preview-title-text>Sistemas, a un pedido</h2>
                <p class="auth-entry__sub" data-preview-subtitle-text>Cargá tu pedido y seguí su estado.</p>
                <ol class="auth-entry__steps" data-preview-zone="steps" hidden>
                  <li><span class="auth-entry__step-n" aria-hidden="true">1</span><b>Received</b><span class="auth-entry__step-text">A request enters one shared queue.</span></li>
                  <li class="on"><span class="auth-entry__step-n" aria-hidden="true">2</span><b>Assigned</b><span class="auth-entry__step-text">The right teammate takes ownership.</span></li>
                  <li><span class="auth-entry__step-n" aria-hidden="true">3</span><b>Resolved</b><span class="auth-entry__step-text">The outcome stays clear and traceable.</span></li>
                </ol>
                <ul class="auth-entry__highlights" data-preview-zone="highlights">
                  <li data-preview-hl-row="0"><span class="auth-entry__hl-icon" aria-hidden="true" data-preview-hl-mark="0"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg></span><div><b data-preview-hl-title-text="0">Primera respuesta en 4 h</b><span data-preview-hl-text-text="0">Los críticos en menos de 30 min.</span></div></li>
                  <li data-preview-hl-row="1"><span class="auth-entry__hl-icon" aria-hidden="true" data-preview-hl-mark="1"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4h3l2 5-2 1a10 10 0 0 0 5 5l1-2 5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 4 6a2 2 0 0 1 2-2z"/></svg></span><div><b data-preview-hl-title-text="1">Guardia 24/7</b><span data-preview-hl-text-text="1">Interno 4400 fuera de horario.</span></div></li>
                  <li data-preview-hl-row="2" hidden><span class="auth-entry__hl-icon" aria-hidden="true" data-preview-hl-mark="2"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg></span><div><b data-preview-hl-title-text="2"></b><span data-preview-hl-text-text="2"></span></div></li>
                </ul>
              </div>
              <div class="auth-entry__foot" data-preview-foot>
                <div data-preview-phone-block><b>Phone</b><span data-preview-phone-text>Interno 4400</span></div>
                <div data-preview-hours-block><b>Hours</b><span data-preview-hours-text>Lun a vie, 8 a 18</span></div>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>
</main>
    <nav class="tabbar" aria-label="Sections">
      <a class="tabbar-item" href="/tickets">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
        <span>Tickets</span>
      </a>
      <a class="tabbar-item" href="/notifications">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
        <span>Notifications</span>
      </a>
      <button class="tabbar-item" type="button" data-sidebar-open aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
        <span>More</span>
      </button>
    </nav>
  </div>
  <div class="notification-panel-host" id="notification-panel-host"></div>
</div>
</body>
</html>
