<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>tkt — Ticket Desk</title>

<script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script>
</head>
<body>
<div class="layout">
  <aside class="rail">
    <a class="rail-brand" href="/tickets" title="tkt">tkt</a>
    <nav class="rail-nav">
      <a class="rail-link" href="/tickets" title="Tickets" aria-label="Tickets">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
      </a>



    </nav>
    <div class="rail-operator" title="Ana Torres">AT</div>
    <form class="rail-logout" method="post" action="/logout">
      <button class="rail-link" type="submit" title="Log out" aria-label="Log out">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3"/><path d="M15 8l4 4-4 4"/><path d="M19 12H9"/></svg>
      </button>
    </form>
  </aside>
  <main class="main">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>

<div class="command-header">
  <div>
    <h1 class="command-title">Edit user</h1>
    <p class="command-sub">Update operator details</p>
  </div>
  <div class="command-actions">
    <a class="btn ghost" href="/users">Back to users</a>
  </div>
</div>

<form class="card form-card" method="post" action="/users/1/edit">
  <h2>Operator details</h2>

  <div class="field">
    <label for="name">Name</label>
    <input type="text" id="name" name="name" value="Ana Torres" required autofocus>
  </div>
  <div class="field">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="ana@example.com" autocomplete="email" required>
  </div>

  <div class="field">
    <label for="role">Role</label>
    <select id="role" name="role">
      <option value="user" >User</option>
      <option value="agent" >Agent</option>

    </select>
  </div>
  <p class="footnote">Deactivate this user to end their sessions and prevent login.</p>
  <button class="btn danger" type="submit" name="active" value="false">Deactivate user</button>

  <button class="btn primary" type="submit">Save changes</button>
</form>

</main>
</div>
</body>
</html>
