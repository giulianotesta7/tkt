<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="htmx-config" content='{"refreshOnHistoryMiss":true}'>
<title>Settings · Help desk</title>

<link rel="stylesheet" href="/static/settings.css"><script src="/static/settings.js" defer></script><script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script><script src="/static/notifications.js" defer></script><script src="/static/shell.js" defer></script>
</head>
<body class="">
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="shell">
  <aside class="sidebar" id="sidebar" aria-label="Sidebar">
    <div class="sidebar-brand">
      <a class="brand-mark" href="/tickets" aria-label="tkt">T</a>
      <a class="brand-text" href="/tickets" tabindex="-1" aria-hidden="true"><span class="brand-name">tkt</span><span class="brand-product">Help desk</span></a>
      <button class="sidebar-close" type="button" data-sidebar-close aria-label="Close menu">×</button>
    </div>
    <nav class="sidebar-nav" aria-label="Sections">
      <div class="sidebar-group">
        <span class="sidebar-group-label">Work</span>
        <a class="sidebar-link" href="/tickets" data-tip="Tickets">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
          <span class="sidebar-label">Tickets</span>
        </a>
        <a class="sidebar-link" href="/tickets/metrics" data-tip="Metrics">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/></svg>
          <span class="sidebar-label">Metrics</span>
        </a>
      </div>
      <div class="sidebar-group">
        <span class="sidebar-group-label">Administration</span>
        <a class="sidebar-link" href="/users" data-tip="Users">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17.5" cy="9" r="2.5"/><path d="M16 14.6a6 6 0 0 1 5.5 5.4"/></svg>
          <span class="sidebar-label">Users</span>
        </a>
        <a class="sidebar-link active" href="/settings" data-tip="Settings" aria-current="page">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
          <span class="sidebar-label">Settings</span>
        </a>
      </div>
    </nav>
    <div class="sidebar-foot">
      <button class="sidebar-collapse" type="button" data-sidebar-collapse aria-pressed="false" data-tip="Expand sidebar" data-label-collapse="Collapse sidebar" data-label-expand="Expand sidebar" aria-keyshortcuts="[">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 7l-5 5 5 5"/><path d="M18 7l-5 5 5 5"/></svg>
        <span class="sidebar-label">Collapse sidebar</span>
      </button>
      <div class="sidebar-user">
        <button class="sidebar-user-button" type="button" data-user-menu-toggle aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" data-tip="Ana Torres">
          <span class="sidebar-avatar" aria-hidden="true">AT</span>
          <span class="sidebar-label sidebar-user-text"><span class="sidebar-user-name">Ana Torres</span><span class="sidebar-user-role"></span></span>
          <svg class="sidebar-user-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 14l6-6 6 6"/></svg>
        </button>
        <div class="user-menu" id="user-menu" role="menu" aria-label="Ana Torres" hidden>
          <a class="user-menu-item" role="menuitem" href="/preferences">Preferences</a>
          <form class="user-menu-logout" method="post" action="/logout">
            <button class="user-menu-item" role="menuitem" type="submit">Log out</button>
          </form>
        </div>
      </div>
    </div>
  </aside>
  <div class="sidebar-scrim" data-sidebar-close hidden></div>
  <div class="shell-body">
    <header class="topbar">
      <button class="topbar-menu" type="button" data-sidebar-open aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
      </button>
      <span class="topbar-section" aria-hidden="true">Settings</span>
      <div class="topbar-spacer"></div>
      <div class="topbar-notifications" id="notification-bell" hx-get="/notifications/count" hx-trigger="load, every 45s [document.visibilityState === 'visible'], notifications:changed from:body" hx-target="this" hx-swap="innerHTML"><a class="bell-link" id="notification-bell-link" href="/notifications" hx-get="/notifications" hx-target="#notification-panel-host" hx-swap="innerHTML" title="Notifications" aria-label="Notifications">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
</a></div>
      <a class="btn primary topbar-new" href="/tickets/new">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        <span class="topbar-new-label">New ticket</span>
      </a>
    </header>
    <main class="main" id="main-content">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>

<div class="command-header">
  <div>
    <h1 class="command-title">Settings</h1>
  </div>
</div>
<div class="settings-layout">

<nav class="settings-nav" aria-label="Settings sections">
  <a class="settings-nav-link" href="/settings/organization">Organization</a>
  <a class="settings-nav-link" href="/settings/signin">Sign-in page</a>
  <a class="settings-nav-link" href="/settings/language">Language</a>
  <a class="settings-nav-link" href="/settings/tickets" aria-current="page">Tickets &amp; SLA</a>
  <a class="settings-nav-link" href="/settings/email">Email notifications</a>
  <a class="settings-nav-link" href="/settings/security">Security</a>
  <a class="settings-nav-link" href="/settings/calendar">Working calendar</a>
</nav>

  <div class="settings-content">
    <h2 class="settings-section-title">Tickets &amp; SLA</h2>
    <form class="settings-form card form-card" method="post" action="/settings/ticket-creation" data-settings-form>
      <h3 class="settings-group-title">Ticket creation</h3>
      <fieldset class="settings-choice-group">
        <legend class="field-label">How the category is chosen</legend>
      </fieldset>
      <div class="settings-savebar" data-settings-savebar hidden>
        <button class="btn primary" type="submit">Save creation flow</button>
        <button class="btn" type="reset">Discard</button>
      </div>
    </form>

    <form class="settings-form card form-card" method="post" action="/settings/category-suggestions" data-settings-form>
      <h3 class="settings-group-title" id="category-suggestions-title">Category suggestions</h3>
      <p class="help">Suggest up to three categories from what the requester writes. Requesters always choose; with no confident suggestion they use the catalog as today.</p>
      <fieldset class="settings-choice-group" aria-labelledby="category-suggestions-title">
        <label class="settings-choice settings-choice-detailed">
          <input type="radio" name="suggestion_engine" value="off" checked>
          <span class="settings-choice-label">Off<small class="settings-choice-help">Requesters choose the category themselves, as today.</small></span>
        </label>
        <label class="settings-choice settings-choice-detailed">
          <input type="radio" name="suggestion_engine" value="local">
          <span class="settings-choice-label">On this server<small class="settings-choice-help">Matches the description against category names, descriptions and keywords. Nothing leaves TKT.</small></span>
        </label>
        <label class="settings-choice settings-choice-detailed">
          <input type="radio" name="suggestion_engine" value="model">
          <span class="settings-choice-label">Decision model<small class="settings-choice-help">Sends the description and the category list to an external decision model (OpenAI Decisions format). Falls back to “On this server” if it fails or takes longer than 2 seconds.</small></span>
        </label>
      </fieldset>
      <div class="settings-suggestion-model" data-show-when="suggestion_engine=model" hidden>
        <div class="field">
          <label for="suggestion_endpoint">Endpoint URL</label>
          <input type="text" id="suggestion_endpoint" name="suggestion_endpoint" value="" spellcheck="false" autocapitalize="off" placeholder="https://api.openai.com/v1">
          <p class="help">Any service that implements POST /decisions, for example OpenAI or Vercel AI Gateway (which also reaches Jev).</p>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="suggestion_model">Model</label>
            <input type="text" id="suggestion_model" name="suggestion_model" value="" spellcheck="false" autocapitalize="off" placeholder="gpt-6-luna">
          </div>
          <div class="field">
            <label for="suggestion_api_key">API key</label>
            <input type="password" id="suggestion_api_key" name="suggestion_api_key" value="" autocomplete="new-password" aria-describedby="suggestion_api_key_help">
            <p class="help" id="suggestion_api_key_help">Stored encrypted.</p>
          </div>
        </div>
        <p class="help"><strong>Sent:</strong> the description and each category&#39;s name and description. <strong>Never sent:</strong> the requester&#39;s name or email, attachments, or ticket history.</p>
      </div>
      <div class="settings-suggestion-try" data-show-when="suggestion_engine!=off" hidden>
        <label for="suggestion_try">Try it</label>
        <div class="settings-suggestion-try-row">
          <input type="text" id="suggestion_try" name="suggestion_try" value="" placeholder="Type a description a requester might write" data-suggestion-try-input autocomplete="off">
          <button class="btn" type="button" data-suggestion-try hx-post="/settings/category-suggestions/try" hx-include="closest form" hx-target="#category-suggestions-try-result" hx-swap="innerHTML">Test</button>
        </div>
        <div id="category-suggestions-try-result" class="settings-suggestion-try-result" aria-live="polite"></div>
      </div>
      <div class="settings-savebar" data-settings-savebar hidden>
        <button class="btn primary" type="submit">Save category suggestions</button>
        <button class="btn" type="reset">Discard</button>
      </div>
    </form>

    <form class="settings-form card form-card" method="post" action="/settings/sla" data-settings-form>
      <h3 class="settings-group-title">Service level agreements (SLA)</h3>
      <p class="help">Defaults for new categories. Editing them does not change existing categories.</p>
      <div class="field checkbox-field">
        <label><input type="checkbox" name="sla_enabled" value="1"> Enable SLA targets</label>
      </div>
      <div class="field">
        <label for="sla_warning_percent">Warning threshold</label><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about Warning threshold" aria-describedby="help-tip-sla-warning" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-sla-warning">At risk once this share of the target has elapsed.</span></span>
        <input type="number" id="sla_warning_percent" name="sla_warning_percent" class="sla-warning-input" min="1" max="99" value="80">
      </div>
<div class="sla-grid sla-duration-grid" data-sla-durations data-duration-max="9223372036854775807" data-duration-invalid="Use whole numbers with h, m or s, without repeated units. Example: 1h 30m." data-duration-minimum="The target must be at least 60 seconds.">
  <p id="sla-duration-help" class="sla-duration-help">Use h, m and s: 1h 30m, 90m or 45m 20s. Minimum: 60 seconds.</p>
  <div class="sla-grid-row sla-grid-head" aria-hidden="true"><span></span><span>First response</span><span>Resolve</span></div>

  <div class="sla-grid-row">
    <span class="sla-grid-priority">Critical</span>
    <div class="sla-duration-field"><label class="sla-duration-label" for="first_response_duration_critical">First response</label><input class="sla-duration-input" id="first_response_duration_critical" name="first_response_duration_critical" value="30m" aria-label="Critical first response" aria-describedby="sla-duration-help first_response_duration_critical-reading" aria-invalid="false" autocomplete="off" spellcheck="false" required><p id="first_response_duration_critical-reading" class="sla-duration-reading">30 min</p></div>
    <div class="sla-duration-field"><label class="sla-duration-label" for="resolve_duration_critical">Resolve</label><input class="sla-duration-input" id="resolve_duration_critical" name="resolve_duration_critical" value="4h" aria-label="Critical resolve" aria-describedby="sla-duration-help resolve_duration_critical-reading" aria-invalid="false" autocomplete="off" spellcheck="false" required><p id="resolve_duration_critical-reading" class="sla-duration-reading">4 h</p></div>
  </div>

  <div class="sla-grid-row">
    <span class="sla-grid-priority">High</span>
    <div class="sla-duration-field"><label class="sla-duration-label" for="first_response_duration_high">First response</label><input class="sla-duration-input" id="first_response_duration_high" name="first_response_duration_high" value="1h" aria-label="High first response" aria-describedby="sla-duration-help first_response_duration_high-reading" aria-invalid="false" autocomplete="off" spellcheck="false" required><p id="first_response_duration_high-reading" class="sla-duration-reading">1 h</p></div>
    <div class="sla-duration-field"><label class="sla-duration-label" for="resolve_duration_high">Resolve</label><input class="sla-duration-input" id="resolve_duration_high" name="resolve_duration_high" value="8h" aria-label="High resolve" aria-describedby="sla-duration-help resolve_duration_high-reading" aria-invalid="false" autocomplete="off" spellcheck="false" required><p id="resolve_duration_high-reading" class="sla-duration-reading">8 h</p></div>
  </div>

  <div class="sla-grid-row">
    <span class="sla-grid-priority">Medium</span>
    <div class="sla-duration-field"><label class="sla-duration-label" for="first_response_duration_medium">First response</label><input class="sla-duration-input" id="first_response_duration_medium" name="first_response_duration_medium" value="4h" aria-label="Medium first response" aria-describedby="sla-duration-help first_response_duration_medium-reading" aria-invalid="false" autocomplete="off" spellcheck="false" required><p id="first_response_duration_medium-reading" class="sla-duration-reading">4 h</p></div>
    <div class="sla-duration-field"><label class="sla-duration-label" for="resolve_duration_medium">Resolve</label><input class="sla-duration-input" id="resolve_duration_medium" name="resolve_duration_medium" value="24h" aria-label="Medium resolve" aria-describedby="sla-duration-help resolve_duration_medium-reading" aria-invalid="false" autocomplete="off" spellcheck="false" required><p id="resolve_duration_medium-reading" class="sla-duration-reading">24 h</p></div>
  </div>

  <div class="sla-grid-row">
    <span class="sla-grid-priority">Low</span>
    <div class="sla-duration-field"><label class="sla-duration-label" for="first_response_duration_low">First response</label><input class="sla-duration-input" id="first_response_duration_low" name="first_response_duration_low" value="8h" aria-label="Low first response" aria-describedby="sla-duration-help first_response_duration_low-reading" aria-invalid="false" autocomplete="off" spellcheck="false" required><p id="first_response_duration_low-reading" class="sla-duration-reading">8 h</p></div>
    <div class="sla-duration-field"><label class="sla-duration-label" for="resolve_duration_low">Resolve</label><input class="sla-duration-input" id="resolve_duration_low" name="resolve_duration_low" value="72h" aria-label="Low resolve" aria-describedby="sla-duration-help resolve_duration_low-reading" aria-invalid="false" autocomplete="off" spellcheck="false" required><p id="resolve_duration_low-reading" class="sla-duration-reading">72 h</p></div>
  </div>
</div>
      <div class="settings-savebar" data-settings-savebar hidden>
        <button class="btn primary" type="submit">Save SLA settings</button>
        <button class="btn" type="reset">Discard</button>
      </div>
    </form>
    <form class="settings-form card form-card" method="post" action="/settings/hold-auto-close" data-settings-form>
      <h3 class="settings-group-title">Automatic close of held tickets</h3>
      <p class="help">When the requester never answers, warn them one working day before and then close the ticket.</p>
      <div class="field">
        <label for="hold_auto_close_working_days">Close tickets on hold after N working days without a reply</label><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about Close tickets on hold after N working days without a reply" aria-describedby="help-tip-hold-auto-close-days" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-hold-auto-close-days">Empty means off: the instance never closes a held ticket on its own. Working days follow the SLA working calendar.</span></span>
        <input type="number" id="hold_auto_close_working_days" name="hold_auto_close_working_days" class="sla-warning-input" min="0" value="">
      </div>
      <div class="settings-savebar" data-settings-savebar hidden>
        <button class="btn primary" type="submit">Save automatic close</button>
        <button class="btn" type="reset">Discard</button>
      </div>
    </form>
    <form class="settings-form card form-card" method="post" action="/settings/appearance" data-settings-form>
      <h3 class="settings-group-title">Internal comment background</h3>
      <div class="swatch-grid">

    <label class="swatch">
    <input type="radio" name="internal_comment_bg" value="#E8EEFF" checked>
      <span class="swatch-chip" style="background:#E8EEFF"></span>
      <span class="swatch-label">Blue</span>
    </label>

    <label class="swatch">
    <input type="radio" name="internal_comment_bg" value="#EFE9FB">
      <span class="swatch-chip" style="background:#EFE9FB"></span>
      <span class="swatch-label">Violet</span>
    </label>

    <label class="swatch">
    <input type="radio" name="internal_comment_bg" value="#FFF6DC">
      <span class="swatch-chip" style="background:#FFF6DC"></span>
      <span class="swatch-label">Yellow</span>
    </label>

  </div>
      <div class="settings-savebar" data-settings-savebar hidden>
        <button class="btn primary" type="submit">Save appearance</button>
        <button class="btn" type="reset">Discard</button>
      </div>
    </form>
  </div>
</div>
<script src="/static/sla_duration.js" defer></script>
</main>
    <nav class="tabbar" aria-label="Sections">
      <a class="tabbar-item" href="/tickets">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
        <span>Tickets</span>
      </a>
      <a class="tabbar-item" href="/notifications">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
        <span>Notifications</span>
      </a>
      <button class="tabbar-item" type="button" data-sidebar-open aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
        <span>More</span>
      </button>
    </nav>
  </div>
  <div class="notification-panel-host" id="notification-panel-host"></div>
</div>
</body>
</html>
