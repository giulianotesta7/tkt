<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>tkt — Ticket Desk</title>

<script src="/static/tickets.js" defer></script><script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script>
</head>
<body>
<div class="layout">
  <aside class="rail">
    <a class="rail-brand" href="/tickets" title="tkt">tkt</a>
    <nav class="rail-nav">
      <a class="rail-link active" href="/tickets" title="Tickets" aria-label="Tickets">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
      </a>



    </nav>
    <div class="rail-operator" title="Ana Torres">AT</div>
    <form class="rail-logout" method="post" action="/logout">
      <button class="rail-link" type="submit" title="Log out" aria-label="Log out">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3"/><path d="M15 8l4 4-4 4"/><path d="M19 12H9"/></svg>
      </button>
    </form>
  </aside>
  <main class="main">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>
<div class="page-foundation tickets-header">
  <header class="page-header">
    <div>
      <h1 class="page-title">My work</h1>
    </div>
    <div class="page-actions">
      <form class="ticket-search search-field" method="get" action="/tickets" hx-get="/tickets" hx-target="#tickets-screen" hx-swap="outerHTML" hx-push-url="true">
  <label class="visually-hidden" for="role-ticket-search">Search tickets</label>
  <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
  <input id="role-ticket-search" type="search" name="q" value="printer" placeholder="Search by ID or title" aria-label="Search tickets" hx-preserve="true" hx-get="/tickets" hx-trigger="input changed delay:300ms" hx-target="#tickets-screen" hx-swap="outerHTML" hx-push-url="true">
</form><a class="page-action page-action-primary" href="/tickets/new">New ticket</a>
    </div>
  </header>
</div><section id="tickets-screen" class="page-foundation tickets-screen"><div id="agent-ticket-list">
  <section class="agent-queue" aria-labelledby="assigned-tickets-title">
    <header class="command-header"><h2 id="assigned-tickets-title" class="command-title">Assigned to me · 2</h2></header>
    <ul class="agent-queue-list">
      <li class="agent-row agent-row-assigned">
        <div class="agent-row-main">
          <a class="agent-row-title" href="/tickets/2">Printer jam</a>
          <span class="agent-row-number">TKT-2</span>

          <p class="agent-row-meta">Desk: Service desk</p>
          <p class="agent-row-meta">Requester: Ana Torres</p>
        </div>
        <div class="agent-row-side">
          <span class="badge in_progress">In Progress</span>
          <span class="priority high"><span class="ticket-priority-value">High</span></span>
          <span class="agent-row-updated">Updated <time class="card-timestamp" tabindex="0" datetime="2026-08-06T10:30:00Z" aria-label="10:30 · 06-08-2026" data-full-date="10:30 · 06-08-2026">10:30 · 06 Aug</time></span>
          <a class="agent-row-open" href="/tickets/2">Open ticket</a>
        </div>
      </li>
      <li class="agent-row agent-row-assigned">
        <div class="agent-row-main">
          <a class="agent-row-title" href="/tickets/1">Login page down</a>
          <span class="agent-row-number">TKT-1</span>
          <p class="agent-row-task">Current task: Restart the printer spooler</p>
          <p class="agent-row-meta">No desk assigned</p>
          <p class="agent-row-meta">Requester: Ana Torres</p>
        </div>
        <div class="agent-row-side">
          <span class="badge new">New</span>
          <span class="priority critical"><span class="ticket-priority-value">Critical</span></span>
          <span class="agent-row-updated">Updated <time class="card-timestamp" tabindex="0" datetime="2026-08-06T10:00:00Z" aria-label="10:00 · 06-08-2026" data-full-date="10:00 · 06-08-2026">10:00 · 06 Aug</time></span>
          <a class="agent-row-open" href="/tickets/1">Open ticket</a>
        </div>
      </li>
    </ul>
  </section>
  <section class="agent-queue" aria-labelledby="claimable-tickets-title">
    <header class="command-header"><h2 id="claimable-tickets-title" class="command-title">Available to claim · 1</h2></header>
    <ul class="agent-queue-list">
      <li class="agent-row agent-row-claimable">
        <div class="agent-row-main">
          <a class="agent-row-title" href="/tickets/3">Email bounce</a>
          <span class="agent-row-number">TKT-3</span>
          <p class="agent-row-meta">Requester: Ana Torres</p>
          <p class="agent-row-meta">Desk: Service desk</p>
          <span class="agent-row-updated">Created <time class="card-timestamp" tabindex="0" datetime="2026-08-06T10:30:00Z" aria-label="10:30 · 06-08-2026" data-full-date="10:30 · 06-08-2026">10:30 · 06 Aug</time></span>
        </div>
        <div class="agent-row-side">
          <span class="badge new">New</span>
          <span class="priority medium"><span class="ticket-priority-value">Medium</span></span>
          <div class="agent-row-actions">
            <a class="agent-row-open" href="/tickets/3">View ticket</a>

          </div>
        </div>
      </li>
    </ul>
  </section>
</div></section></main>
</div>
</body>
</html>
