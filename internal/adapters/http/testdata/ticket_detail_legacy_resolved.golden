</div>

      </div>
    </div>
    <div class="evidence">
      <div class="prop-list">
        <div class="prop-section">
          <div class="prop-heading">Properties</div>
          <div class="prop-row">
            <span class="prop-label">Requester</span>
            <span class="prop-value">Beto Ruiz</span>
          </div>
          <div class="prop-row">
            <span class="prop-label">Category</span>
            <span id="ticket-category-value" class="prop-value">Bugs</span>
          </div>
          
        </div>
        <div class="prop-section">
          <div class="prop-heading">Assignment</div>

          <div class="prop-row">
            <span class="prop-label">Assignee</span>

            <span class="prop-value">Ana Torres</span>
            
          </div>

        </div>
        <div class="prop-section">
          <div class="prop-heading">State</div>
          <div class="prop-row">
            <span class="prop-label">Current</span>
            <span class="prop-value"><span class="badge resolved">Resolved</span></span>
          </div>

          <div class="prop-row">
            <span class="prop-label">Move to</span>
            <form class="prop-control transition-control" method="post" action="/tickets/1/transition"
                  hx-post="/tickets/1/transition" hx-target="#ticket-detail" hx-swap="outerHTML">
              <select id="ticket-state" name="to" class="prop-select"
                      aria-label="Move to state" required>
                <option value="" disabled selected>Select…</option>
                <option value="closed">Closed</option><option value="in_progress" data-needs-reason>In Progress (reason required)</option>
              </select>
              <div id="state-reason-field" class="state-reason-field">
                <label for="state-reason">Reopen reason</label>
                <input type="text" id="state-reason" name="reason" class="state-reason"
                       placeholder="Required" required>
              </div>
              <button type="submit" id="state-apply" class="btn small state-apply">Apply</button>
            </form>
          </div>


          <dl class="lifecycle-meta">
            <dt>Resolved</dt><dd><time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time></dd>


          </dl>

        </div>
      </div>
    </div>
  </div>
  <dialog id="ticket-title-dialog" aria-labelledby="ticket-title-dialog-title" aria-describedby="ticket-title-dialog-copy">
    <h2 id="ticket-title-dialog-title">Save the title first?</h2>
    <p id="ticket-title-dialog-copy">The ticket title has unsaved changes.</p>
    <div><button type="button" class="btn" data-title-discard>Discard and continue</button><button type="button" class="btn" data-title-save-continue>Save and continue</button></div>
  </dialog>
</div>
<script>






function syncReopenReason(select) {
  const field = document.getElementById('state-reason-field');
  const reason = document.getElementById('state-reason');
  if (!field || !reason) return;
  const opt = select && select.options[select.selectedIndex];
  const needs = opt && opt.hasAttribute('data-needs-reason');
  field.classList.toggle('visible', !!needs);
  reason.required = !!needs;
  if (needs) {
    reason.focus();
  }
}











function initTitleEditor() {
  const input = document.getElementById('ticket-title');
  const titleForm = input ? input.form : null;
  const detail = document.getElementById('ticket-detail');
  const dialog = document.getElementById('ticket-title-dialog');
  if (!input || !titleForm || !detail || !dialog) return;
  const saveButton = titleForm.querySelector('.title-save');
  const discardButton = dialog.querySelector('[data-title-discard]');
  const saveContinueButton = dialog.querySelector('[data-title-save-continue]');
  const initial = input.value;
  let pendingForm = null;
  let pendingSelectId = null;
  let returnFocus = null;
  const dirty = () => input.value !== initial;
  const syncSave = () => {
    if (saveButton) saveButton.hidden = !dirty();
  };
  const showDialog = () => {
    const active = document.activeElement;
    returnFocus = active && detail.contains(active) && active !== detail ? active : input;
    if (dialog.showModal) dialog.showModal();
    else dialog.setAttribute('open', '');
    if (discardButton) discardButton.focus();
  };
  const closeDialog = (restoreFocus) => {
    if (dialog.open) dialog.close();
    else dialog.removeAttribute('open');
    const target = returnFocus;
    returnFocus = null;
    if (restoreFocus && target && target.isConnected) target.focus();
  };
  input.addEventListener('input', syncSave);
  syncSave();
  detail.addEventListener(
    'click',
    (event) => {
      const target = event.target;
      if (!dirty() || !(target instanceof Element) || target.closest('.title-edit')) return;
      const button = target.closest('button[type=submit]');
      const owner = button ? button.form : null;
      const field = owner ? owner.querySelector('#ticket-priority, #assign-user, #ticket-state') : null;
      if (!owner || !field) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      pendingForm = owner;
      pendingSelectId = field.id;
      showDialog();
    },
    true,
  );
  dialog.addEventListener('cancel', () => {
    pendingForm = null;
    pendingSelectId = null;
    closeDialog(true);
  });
  if (discardButton) {
    discardButton.addEventListener('click', () => {
      input.value = initial;
      syncSave();
      const form = pendingForm;
      pendingForm = null;
      pendingSelectId = null;
      closeDialog(false);
      if (form) form.requestSubmit();
    });
  }
  if (saveContinueButton) {
    saveContinueButton.addEventListener('click', () => {
      const form = pendingForm;
      const selectId = pendingSelectId;
      pendingForm = null;
      pendingSelectId = null;






      if (!titleForm.checkValidity()) {
        closeDialog(false);
        input.focus();
        titleForm.reportValidity();
        return;
      }
      const entries = [];
      if (form) {
        for (const control of form.elements) {
          if (control.name) entries.push([control.name, control.value]);
        }
      }
      closeDialog(false);
      if (!selectId) return;
      const submitPending = (event) => {
        titleForm.removeEventListener('htmx:afterRequest', submitPending);
        if (!event.detail || event.detail.successful !== true) return;
        const select = document.getElementById(selectId);
        const pending = select ? select.form : null;
        if (!pending) return;
        for (const [name, value] of entries) {
          const control = pending.elements.namedItem(name);
          if (control && 'value' in control) control.value = value;
        }
        if (window.htmx && typeof window.htmx.process === 'function') {
          window.htmx.process(pending);
        }
        pending.requestSubmit();
      };
      titleForm.addEventListener('htmx:afterRequest', submitPending);
      titleForm.requestSubmit();
    });
  }
}






(function () {
  const select = document.getElementById('ticket-state');
  if (select) {



    select.addEventListener('change', () => syncReopenReason(select));
    syncReopenReason(select);
  }
  initTitleEditor();
})();
</script>
