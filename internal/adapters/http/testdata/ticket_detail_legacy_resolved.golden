  <div class="timeline-entry timeline-event">
    <span class="event-icon" aria-hidden="true"></span>
    <div class="body">
      <div class="main"><span class="timeline-action"></span></div>

      <div class="when"><time datetime="2026-08-06T10:00:00Z">10:00 · 06-08-2026</time></div>
