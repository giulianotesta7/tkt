<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Create account · Help desk</title>

</head>
<body>
<main class="auth-entry">
  <div>
    <span class="auth-entry__logo"></span>
    <h1 class="command-title">tkt</h1>
    <p class="help">Help desk</p>
  </div>
  <section class="auth-entry__form-panel">

<form class="login-form" method="post" action="/setup" novalidate>
  <h2>Set up tkt</h2>
  <p class="lead">Create the first account for your support team. This only happens once.</p>

  <div class="field">
    <label for="name">Name</label>
    <input type="text" id="name" name="name" value="" placeholder="Ana Torres" autocomplete="name" required autofocus>
  </div>
  <div class="field">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="" placeholder="you@example.com" autocomplete="email" required>
  </div>
  <div class="field">
    <label for="password">Password</label>
    <input type="password" id="password" name="password" placeholder="••••••••" autocomplete="new-password" required>
  </div>
  <button class="btn primary" type="submit">Create account</button>
  <p class="footnote">Your password is stored securely.</p>
</form>

  </section>
</main>
</body>
</html>
