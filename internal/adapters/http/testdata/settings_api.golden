<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="htmx-config" content='{"refreshOnHistoryMiss":true}'>
<title>Settings · Help desk</title>

<link rel="stylesheet" href="/static/settings.css?v=VERSION"><script src="/static/settings.js?v=VERSION" defer></script><script src="/static/save-feedback.js?v=VERSION" defer></script><script src="/static/htmx.min.js?v=VERSION" defer></script><script src="/static/notifications.js?v=VERSION" defer></script><script src="/static/shell.js?v=VERSION" defer></script>
</head>
<body class="">
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="shell">
  <aside class="sidebar" id="sidebar" aria-label="Sidebar">
    <div class="sidebar-brand">
      <a class="brand-mark" href="/tickets" aria-label="tkt">T</a>
      <a class="brand-text" href="/tickets" tabindex="-1" aria-hidden="true"><span class="brand-name">tkt</span><span class="brand-product">Help desk</span></a>
      <button class="sidebar-close" type="button" data-sidebar-close aria-label="Close menu">×</button>
    </div>
    <nav class="sidebar-nav" aria-label="Sections">
      <div class="sidebar-group">
        <span class="sidebar-group-label">Work</span>
        <a class="sidebar-link" href="/tickets" data-tip="Tickets">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
          <span class="sidebar-label">Tickets</span>
        </a>
        <a class="sidebar-link" href="/tickets/metrics" data-tip="Metrics">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/></svg>
          <span class="sidebar-label">Metrics</span>
        </a>
      </div>
      <div class="sidebar-group">
        <span class="sidebar-group-label">Administration</span>
        <a class="sidebar-link" href="/users" data-tip="Users">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17.5" cy="9" r="2.5"/><path d="M16 14.6a6 6 0 0 1 5.5 5.4"/></svg>
          <span class="sidebar-label">Users</span>
        </a>
        <a class="sidebar-link active" href="/settings" data-tip="Settings" aria-current="page">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
          <span class="sidebar-label">Settings</span>
        </a>
      </div>
    </nav>
    <div class="sidebar-foot">
      <button class="sidebar-collapse" type="button" data-sidebar-collapse aria-pressed="false" data-tip="Expand sidebar" data-label-collapse="Collapse sidebar" data-label-expand="Expand sidebar" aria-keyshortcuts="[">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 7l-5 5 5 5"/><path d="M18 7l-5 5 5 5"/></svg>
        <span class="sidebar-label">Collapse sidebar</span>
      </button>
      <div class="sidebar-user">
        <button class="sidebar-user-button" type="button" data-user-menu-toggle aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" data-tip="Ana Torres">
          <span class="sidebar-avatar" aria-hidden="true">AT</span>
          <span class="sidebar-label sidebar-user-text"><span class="sidebar-user-name">Ana Torres</span><span class="sidebar-user-role"></span></span>
          <svg class="sidebar-user-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 14l6-6 6 6"/></svg>
        </button>
        <div class="user-menu" id="user-menu" role="menu" aria-label="Ana Torres" hidden>
          <a class="user-menu-item" role="menuitem" href="/preferences">Preferences</a>
          <form class="user-menu-logout" method="post" action="/logout">
            <button class="user-menu-item" role="menuitem" type="submit">Log out</button>
          </form>
        </div>
      </div>
    </div>
  </aside>
  <div class="sidebar-scrim" data-sidebar-close hidden></div>
  <div class="shell-body">
    <header class="topbar">
      <button class="topbar-menu" type="button" data-sidebar-open aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
      </button>
      <span class="topbar-section" aria-hidden="true">Settings</span>
      <div class="topbar-spacer"></div>
      <div class="topbar-notifications" id="notification-bell" hx-get="/notifications/count" hx-trigger="load, every 45s [document.visibilityState === 'visible'], notifications:changed from:body" hx-target="this" hx-swap="innerHTML"><a class="bell-link" id="notification-bell-link" href="/notifications" hx-get="/notifications" hx-target="#notification-panel-host" hx-swap="innerHTML" title="Notifications" aria-label="Notifications">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
</a></div>
      <a class="btn primary topbar-new" href="/tickets/new">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        <span class="topbar-new-label">New ticket</span>
      </a>
    </header>
    <main class="main" id="main-content">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>

<div class="command-header">
  <div><h1 class="command-title">Settings</h1><p class="settings-subtitle">Instance configuration</p></div>
</div>
<div class="settings-layout">

<nav class="settings-nav" aria-label="Settings sections">
  <a class="settings-nav-link" href="/settings/organization">Organization</a>
  <a class="settings-nav-link" href="/settings/signin">Sign-in page</a>
  <a class="settings-nav-link" href="/settings/language">Language</a>
  <a class="settings-nav-link" href="/settings/tickets">Tickets &amp; SLA</a>
  <a class="settings-nav-link" href="/settings/email">Email notifications</a>
  <a class="settings-nav-link" href="/settings/security">Security</a>
  <a class="settings-nav-link" href="/settings/calendar">Working calendar</a>
  <a class="settings-nav-link" href="/settings/api" aria-current="page">API</a>
</nav>

  <div class="settings-content" aria-label="API">
    <section class="api-token-once" role="status" aria-labelledby="api-token-title">
      <h2 id="api-token-title" class="settings-section-title">Key Zabbix created</h2>
      <p>Copy this token now. It is shown only once; tkt keeps only a hash of it.</p>
      <input class="api-token-value" type="text" readonly value="tkt_0123456789ab_cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd" aria-label="New API token" spellcheck="false" autocomplete="off" data-api-token>
    </section>
    <section class="settings-group">
      <h2 class="settings-section-title">API access</h2>
      <div class="settings-row">
        <div><h3>API</h3><p>While the API is off, every API request is refused, whatever key it carries.</p></div>
        <div>
          <form method="post" action="/settings/api/toggle">
            <input type="hidden" name="enabled" value="0">
            <p class="api-access-state">On</p>
            <button class="btn" type="submit">Turn off the API</button>
          </form>
        </div>
      </div>
    </section>
    <section class="settings-group">
      <h2 class="settings-section-title">Service users</h2>
      <form class="settings-row" method="post" action="/settings/api/service-users">
        <div><h3>New service user</h3><p>A service user is the identity an API key acts as. It never signs in, is never notified and is never assigned work.</p></div>
        <div class="settings-pair">
          <div class="field"><label for="service_user_name">Name</label><input type="text" id="service_user_name" name="name" required></div>
          <div class="field"><label for="service_user_role">Role</label><select id="service_user_role" name="role"><option value="user">User</option><option value="agent">Agent</option></select></div>
          <div><button class="btn primary" type="submit">Create service user</button></div>
        </div>
      </form>
      <article class="api-service-user" aria-labelledby="api-service-user-7">
        <header class="api-service-user-head">
          <div><h3 id="api-service-user-7">Triage bot</h3><p>Agent · Active</p></div>
          <form method="post" action="/settings/api/service-users/7/active">
            <input type="hidden" name="active" value="0">
            <button class="btn danger small" type="submit">Deactivate Triage bot</button>
          </form>
        </header>
        <div class="api-keys-wrap"><table class="api-keys-table">
          <thead><tr><th scope="col">Key</th><th scope="col">Scopes</th><th scope="col">Status</th><th scope="col">Expires</th><th scope="col">Last used</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
          <tbody>
            <tr>
              <td><strong>Zabbix</strong><small>tkt_0123456789ab_…</small></td>
              <td><code>tickets:read</code>, <code>comments:internal</code></td>
              <td>Active</td>
              <td>2027-01-01</td>
              <td>Not used yet</td>
              <td><form method="post" action="/settings/api/keys/2/revoke"><button class="btn danger small" type="submit">Revoke Zabbix</button></form></td>
            </tr>
            <tr>
              <td><strong>Old</strong><small>tkt_ba9876543210_…</small></td>
              <td><code>tickets:read</code></td>
              <td>Revoked</td>
              <td>Never</td>
              <td>Oct 3, 10:00</td>
              <td></td>
            </tr>
          </tbody>
        </table></div>
        <form class="api-key-form" method="post" action="/settings/api/keys">
          <input type="hidden" name="service_user_id" value="7">
          <div class="field"><label for="api_key_name_7">Key name</label><input type="text" id="api_key_name_7" name="name" required></div>
          <div class="field"><label for="api_key_expires_7">Expires on</label><input type="date" id="api_key_expires_7" name="expires_on"><p class="help">Optional. The key stops working at the start of that day (UTC).</p></div>
          <fieldset class="api-key-scopes">
            <legend>Scopes</legend>
            <label><input type="checkbox" name="scopes" value="catalog:read"> <code>catalog:read</code> Read categories and their forms</label>
            <label><input type="checkbox" name="scopes" value="tickets:read"> <code>tickets:read</code> Read and search tickets</label>
            <label><input type="checkbox" name="scopes" value="tickets:write"> <code>tickets:write</code> Create and update tickets</label>
            <label><input type="checkbox" name="scopes" value="comments:write"> <code>comments:write</code> Write public comments</label>
            <label><input type="checkbox" name="scopes" value="comments:internal"> <code>comments:internal</code> Write internal comments</label>
            <label><input type="checkbox" name="scopes" value="tickets:all" aria-describedby="api-all-help-7"> <code>tickets:all</code> Read and work every ticket</label>
            <p class="help" id="api-all-help-7">A leaked key with this scope can change every ticket.</p>
          </fieldset>
          <div class="api-key-submit"><button class="btn primary" type="submit">Create key for Triage bot</button></div>
        </form>
      </article>
      <article class="api-service-user" aria-labelledby="api-service-user-8">
        <header class="api-service-user-head">
          <div><h3 id="api-service-user-8">Monitoring</h3><p>User · Deactivated</p></div>
          <form method="post" action="/settings/api/service-users/8/active">
            <input type="hidden" name="active" value="1">
            <button class="btn small" type="submit">Reactivate Monitoring</button>
          </form>
        </header>
        <p class="api-empty">No keys yet.</p>
      </article>
    </section>
  </div>
</div>
</main>
    <nav class="tabbar" aria-label="Sections">
      <a class="tabbar-item" href="/tickets">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
        <span>Tickets</span>
      </a>
      <a class="tabbar-item" href="/notifications">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
        <span>Notifications</span>
      </a>
      <button class="tabbar-item" type="button" data-sidebar-open aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
        <span>More</span>
      </button>
    </nav>
  </div>
  <div class="notification-panel-host" id="notification-panel-host"></div>
</div>
</body>
</html>
