<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="htmx-config" content='{"refreshOnHistoryMiss":true}'>
<title>Settings · Help desk</title>

<link rel="stylesheet" href="/static/settings.css"><script src="/static/settings.js" defer></script><script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script><script src="/static/notifications.js" defer></script><script src="/static/shell.js" defer></script>
</head>
<body class="">
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="shell">
  <aside class="sidebar" id="sidebar" aria-label="Sidebar">
    <div class="sidebar-brand">
      <a class="brand-mark" href="/tickets" aria-label="tkt">T</a>
      <a class="brand-text" href="/tickets" tabindex="-1" aria-hidden="true"><span class="brand-name">tkt</span><span class="brand-product">Help desk</span></a>
      <button class="sidebar-close" type="button" data-sidebar-close aria-label="Close menu">×</button>
    </div>
    <nav class="sidebar-nav" aria-label="Sections">
      <div class="sidebar-group">
        <span class="sidebar-group-label">Work</span>
        <a class="sidebar-link" href="/tickets" data-tip="Tickets">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
          <span class="sidebar-label">Tickets</span>
        </a>
        <a class="sidebar-link" href="/tickets/metrics" data-tip="Metrics">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/></svg>
          <span class="sidebar-label">Metrics</span>
        </a>
      </div>
      <div class="sidebar-group">
        <span class="sidebar-group-label">Administration</span>
        <a class="sidebar-link" href="/users" data-tip="Users">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17.5" cy="9" r="2.5"/><path d="M16 14.6a6 6 0 0 1 5.5 5.4"/></svg>
          <span class="sidebar-label">Users</span>
        </a>
        <a class="sidebar-link active" href="/settings" data-tip="Settings" aria-current="page">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
          <span class="sidebar-label">Settings</span>
        </a>
      </div>
    </nav>
    <div class="sidebar-foot">
      <button class="sidebar-collapse" type="button" data-sidebar-collapse aria-pressed="false" data-tip="Expand sidebar" data-label-collapse="Collapse sidebar" data-label-expand="Expand sidebar" aria-keyshortcuts="[">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 7l-5 5 5 5"/><path d="M18 7l-5 5 5 5"/></svg>
        <span class="sidebar-label">Collapse sidebar</span>
      </button>
      <div class="sidebar-user">
        <button class="sidebar-user-button" type="button" data-user-menu-toggle aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" data-tip="Ana Torres">
          <span class="sidebar-avatar" aria-hidden="true">AT</span>
          <span class="sidebar-label sidebar-user-text"><span class="sidebar-user-name">Ana Torres</span><span class="sidebar-user-role"></span></span>
          <svg class="sidebar-user-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 14l6-6 6 6"/></svg>
        </button>
        <div class="user-menu" id="user-menu" role="menu" aria-label="Ana Torres" hidden>
          <a class="user-menu-item" role="menuitem" href="/preferences">Preferences</a>
          <form class="user-menu-logout" method="post" action="/logout">
            <button class="user-menu-item" role="menuitem" type="submit">Log out</button>
          </form>
        </div>
      </div>
    </div>
  </aside>
  <div class="sidebar-scrim" data-sidebar-close hidden></div>
  <div class="shell-body">
    <header class="topbar">
      <button class="topbar-menu" type="button" data-sidebar-open aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
      </button>
      <span class="topbar-section" aria-hidden="true">Settings</span>
      <div class="topbar-spacer"></div>
      <div class="topbar-notifications" id="notification-bell" hx-get="/notifications/count" hx-trigger="load, every 45s [document.visibilityState === 'visible'], notifications:changed from:body" hx-target="this" hx-swap="innerHTML"><a class="bell-link" id="notification-bell-link" href="/notifications" hx-get="/notifications" hx-target="#notification-panel-host" hx-swap="innerHTML" title="Notifications" aria-label="Notifications">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
</a></div>
      <a class="btn primary topbar-new" href="/tickets/new">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        <span class="topbar-new-label">New ticket</span>
      </a>
    </header>
    <main class="main" id="main-content">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>

<div class="command-header">
  <div>
    <h1 class="command-title">Settings</h1>
  </div>
</div>
<div class="settings-layout">

<nav class="settings-nav" aria-label="Settings sections">
  <a class="settings-nav-link" href="/settings/organization">Organization</a>
  <a class="settings-nav-link" href="/settings/signin">Sign-in page</a>
  <a class="settings-nav-link" href="/settings/language">Language</a>
  <a class="settings-nav-link" href="/settings/tickets">Tickets &amp; SLA</a>
  <a class="settings-nav-link" href="/settings/email">Email notifications</a>
  <a class="settings-nav-link" href="/settings/security" aria-current="page">Security</a>
  <a class="settings-nav-link" href="/settings/calendar">Working calendar</a>
</nav>

  <div class="settings-content">
    <h2 class="settings-section-title">Security</h2>
    <form class="settings-form card form-card" method="post" action="/settings/security" data-settings-form>
      <h3 class="settings-group-title">Passwords</h3>
      <div class="switch-list">
        <div class="switch-row">
          <div class="switch-copy">
            <span class="switch-label" id="password-signin-label">Password sign-in</span><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about Password sign-in" aria-describedby="help-tip-security-password-signin" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-security-password-signin">Off for everyone except root. The root account keeps the password form as a break-glass in case the provider fails.</span></span>
            <p class="dep-note">Password sign-in is off. Only root can still use the password form, which the sign-in page keeps as a break-glass. “Forgot your password?” and Preferences › Password are hidden.</p>
          </div>
          <span class="switch"><input type="checkbox" id="password_signin_enabled" name="password_signin_enabled" value="1" form="company-signin-form" aria-labelledby="password-signin-label"></span>
        </div>
        <div class="switch-row">
          <div class="switch-copy">
            <span class="switch-label" id="password-change-label">Allow people to change their own password from Preferences</span><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about Allow people to change their own password from Preferences" aria-describedby="help-tip-security-password-change" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-security-password-change">Preferences gets a Password section. Administrators keep the Users action that sets any password.</span></span>
          </div>
          <span class="switch"><input type="checkbox" id="password_change_enabled" name="password_change_enabled" value="1" aria-labelledby="password-change-label" checked></span>
        </div>
        <div class="switch-row">
          <div class="switch-copy">
            <span class="switch-label" id="password-recovery-label">Offer “Forgot your password?” on the sign-in page</span><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about Offer “Forgot your password?” on the sign-in page" aria-describedby="help-tip-security-password-recovery" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-security-password-recovery">Sends a single-use link that expires in 1 hour. Needs email notifications.</span></span>
            <p class="dep-note">Email notifications are off, so this switch has no effect. <a href="/settings/email">Set up email notifications</a>.</p>
          </div>
          <span class="switch"><input type="checkbox" id="password_recovery_enabled" name="password_recovery_enabled" value="1" aria-labelledby="password-recovery-label"></span>
        </div>
      </div>
      <div class="field">
        <label for="password_min_length">Minimum password length</label><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about Minimum password length" aria-describedby="help-tip-security-min-length" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-security-min-length">Between 8 and 64 characters. Applies to every new password; existing passwords keep working.</span></span>
        <div class="stepper">
          <button type="button" class="stepper-step" data-step="-1" aria-label="Decrease minimum length">−</button>
          <input class="num" id="password_min_length" name="password_min_length" type="number" min="8" max="64" step="1" value="16">
          <button type="button" class="stepper-step" data-step="1" aria-label="Increase minimum length">+</button>
        </div>
      </div>
      <div class="settings-savebar" data-settings-savebar hidden>
        <button class="btn primary" type="submit">Save password settings</button>
        <button class="btn" type="reset">Discard</button>
      </div>
    </form>
    <form class="settings-company-form" id="company-signin-form" method="post" action="/settings/security/company" data-settings-form>
      <div class="card form-card">
        <h3 class="settings-group-title">Company sign-in</h3>
        <div class="field">
          <label for="company_signin_address">TKT address</label><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about TKT address" aria-describedby="help-tip-company-address" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-company-address">The public address of this instance, such as https://tkt.example.com. Both redirect URIs are built from it: the address cannot be taken safely from the request host.</span></span>
          <input type="text" id="company_signin_address" name="company_signin_address" value="https://tkt.example.test" spellcheck="false" autocapitalize="off" placeholder="https://tkt.example.com">
        </div>
      </div>
      <div class="card form-card">
        <div class="switch-row settings-provider-head">
          <div class="switch-copy">
            <h3 class="settings-group-title" id="google-signin-label"><svg class="company-logo" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.4-4.8 7.1l7.6 5.9c4.5-4.1 7-10.2 7-17.5z"/><path fill="#FBBC05" d="M10.5 28.7A14.5 14.5 0 0 1 9.5 24c0-1.6.3-3.2.8-4.7l-7.9-6.1A24 24 0 0 0 0 24c0 3.9.9 7.5 2.6 10.8l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.9c-2.1 1.4-4.9 2.3-8.3 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg>Google Workspace</h3>
          </div>
          <span class="switch"><input type="checkbox" id="google_enabled" name="google_enabled" value="1" aria-labelledby="google-signin-label" checked></span>
        </div>
        <div class="field">
          <label for="google_client_id">Client ID</label>
          <input type="text" id="google_client_id" name="google_client_id" value="812345678901-acme.apps.googleusercontent.com" spellcheck="false" autocapitalize="off" autocomplete="off">
        </div>
        <div class="field">
          <label for="google_client_secret">Client secret <span class="chip">Saved</span></label><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about Client secret" aria-describedby="help-tip-google-secret" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-google-secret">Stored encrypted and never shown again. Leave it blank to keep the saved secret.</span></span>
          <input type="password" id="google_client_secret" name="google_client_secret" value="" autocomplete="new-password">
        </div>
        <div class="field">
          <label for="google_domains">Allowed domains</label><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about Allowed domains" aria-describedby="help-tip-google-domains" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-google-domains">One domain per line. Only Google accounts whose verified email ends in one of these domains can sign in. An account outside them is refused.</span></span>
          <textarea id="google_domains" name="google_domains" spellcheck="false" autocapitalize="off">acme.test
acme-support.test</textarea>
        </div>
        <div class="field">
          <label for="google_redirect_uri">Redirect URI</label><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about Redirect URI" aria-describedby="help-tip-google-redirect" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-google-redirect">Built from the TKT address above. Paste it into the Google Cloud console as an authorized redirect URI.</span></span>
          <div class="copy-field">
            <input type="text" id="google_redirect_uri" class="settings-readonly" value="https://tkt.example.test/auth/google/callback" readonly spellcheck="false">
            <button type="button" class="btn" data-copy-target="google_redirect_uri" data-copied-label="Copied">Copy</button>
          </div>
          <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
        </div>
      </div>
      <div class="card form-card">
        <div class="switch-row settings-provider-head">
          <div class="switch-copy">
            <h3 class="settings-group-title" id="microsoft-signin-label"><svg class="company-logo" viewBox="0 0 23 23" aria-hidden="true" focusable="false"><path fill="#F25022" d="M1 1h10v10H1z"/><path fill="#7FBA00" d="M12 1h10v10H12z"/><path fill="#00A4EF" d="M1 12h10v10H1z"/><path fill="#FFB900" d="M12 12h10v10H12z"/></svg>Microsoft Entra</h3>
          </div>
          <span class="switch"><input type="checkbox" id="microsoft_enabled" name="microsoft_enabled" value="1" aria-labelledby="microsoft-signin-label"></span>
        </div>
        <div class="field">
          <label for="microsoft_tenant_id">Directory (tenant) ID</label><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about Directory (tenant) ID" aria-describedby="help-tip-microsoft-tenant" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-microsoft-tenant">Only accounts from this tenant can sign in. The tenant is the restriction, so there is no separate domain list for Microsoft.</span></span>
          <input type="text" id="microsoft_tenant_id" name="microsoft_tenant_id" value="72f988bf-86f1-41af-91ab-2d7cd011db47" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="00000000-0000-0000-0000-000000000000">
        </div>
        <div class="field">
          <label for="microsoft_client_id">Client ID</label>
          <input type="text" id="microsoft_client_id" name="microsoft_client_id" value="b1d2c3e4-5f60-4718-9abc-def012345678" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="Application (client) ID">
        </div>
        <div class="field">
          <label for="microsoft_client_secret">Client secret <span class="chip">Saved</span></label><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about Client secret" aria-describedby="help-tip-microsoft-secret" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-microsoft-secret">Stored encrypted and never shown again. Leave it blank to keep the saved secret.</span></span>
          <input type="password" id="microsoft_client_secret" name="microsoft_client_secret" value="" autocomplete="new-password">
        </div>
        <div class="field">
          <label for="microsoft_redirect_uri">Redirect URI</label><span class="help-tip-wrap"><button class="help-tip" type="button" aria-label="More about Redirect URI" aria-describedby="help-tip-microsoft-redirect" aria-expanded="false" data-help-tip>?</button><span class="help-tip-bubble" role="tooltip" id="help-tip-microsoft-redirect">Built from the TKT address above. Add it in the Entra portal as a redirect URI of type Web.</span></span>
          <div class="copy-field">
            <input type="text" id="microsoft_redirect_uri" class="settings-readonly" value="https://tkt.example.test/auth/microsoft/callback" readonly spellcheck="false">
            <button type="button" class="btn" data-copy-target="microsoft_redirect_uri" data-copied-label="Copied">Copy</button>
          </div>
          <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
        </div>
        <p class="dep-note">Microsoft sign-in is off. Paste the Directory (tenant) ID, Client ID and Client secret from the Entra portal to turn it on.</p>
      </div>
      <div class="card form-card">
        <fieldset class="settings-choice-group">
          <legend class="field-label">New accounts</legend>
          <label class="settings-choice">
            <input type="radio" name="company_signin_new_accounts" value="requester">
            <span class="settings-choice-label">Create the account as a requester</span>
          </label>
          <label class="settings-choice">
            <input type="radio" name="company_signin_new_accounts" value="pending" checked>
            <span class="settings-choice-label">Create the account as pending approval</span>
          </label>
        </fieldset>
        <p class="dep-note">The account is created pending: it waits for an administrator’s approval, and the person gets no session. Until it is approved, the person sees “Your access is pending approval” and cannot open or see tickets.</p>
      </div>
      <div class="settings-savebar" data-settings-savebar hidden>
        <button class="btn primary" type="submit">Save company sign-in</button>
        <button class="btn" type="reset">Discard</button>
      </div>
    </form>
  </div>
</div>
</main>
    <nav class="tabbar" aria-label="Sections">
      <a class="tabbar-item" href="/tickets">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
        <span>Tickets</span>
      </a>
      <a class="tabbar-item" href="/notifications">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
        <span>Notifications</span>
      </a>
      <button class="tabbar-item" type="button" data-sidebar-open aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
        <span>More</span>
      </button>
    </nav>
  </div>
  <div class="notification-panel-host" id="notification-panel-host"></div>
</div>
</body>
</html>
