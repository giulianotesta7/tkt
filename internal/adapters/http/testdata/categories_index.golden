<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="htmx-config" content='{"refreshOnHistoryMiss":true}'>
<title>Catalog · Help desk</title>

<script src="/static/overlay.js?v=VERSION" defer></script>
<link rel="stylesheet" href="/static/users.css?v=VERSION"><script src="/static/categories.js?v=VERSION" defer></script><script src="/static/catalog-tree.js?v=VERSION" defer></script><script src="/static/save-feedback.js?v=VERSION" defer></script><script src="/static/htmx.min.js?v=VERSION" defer></script><script src="/static/notifications.js?v=VERSION" defer></script><script src="/static/shell.js?v=VERSION" defer></script>
</head>
<body class="users-page-body ">
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="shell">
  <aside class="sidebar" id="sidebar" aria-label="Sidebar">
    <div class="sidebar-brand">
      <a class="brand-mark" href="/tickets" aria-label=""></a>
      <a class="brand-text" href="/tickets" tabindex="-1" aria-hidden="true"><span class="brand-name"></span><span class="brand-product"></span></a>
      <button class="sidebar-close" type="button" data-sidebar-close aria-label="Close menu">×</button>
    </div>
    <nav class="sidebar-nav" aria-label="Sections">
      <div class="sidebar-group">
        <span class="sidebar-group-label">Work</span>
        <a class="sidebar-link" href="/tickets" data-tip="Tickets">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
          <span class="sidebar-label">Tickets</span>
        </a>
      </div>
    </nav>
    <div class="sidebar-foot">
      <button class="sidebar-collapse" type="button" data-sidebar-collapse aria-pressed="false" data-tip="Expand sidebar" data-label-collapse="Collapse sidebar" data-label-expand="Expand sidebar" aria-keyshortcuts="[">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 7l-5 5 5 5"/><path d="M18 7l-5 5 5 5"/></svg>
        <span class="sidebar-label">Collapse sidebar</span>
      </button>
      <div class="sidebar-user">
        <button class="sidebar-user-button" type="button" data-user-menu-toggle aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" data-tip="Ana Torres">
          <span class="sidebar-avatar" aria-hidden="true">AT</span>
          <span class="sidebar-label sidebar-user-text"><span class="sidebar-user-name">Ana Torres</span><span class="sidebar-user-role"></span></span>
          <svg class="sidebar-user-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 14l6-6 6 6"/></svg>
        </button>
        <div class="user-menu" id="user-menu" role="menu" aria-label="Ana Torres" hidden>
          <a class="user-menu-item" role="menuitem" href="/preferences">Preferences</a>
          <form class="user-menu-logout" method="post" action="/logout">
            <button class="user-menu-item" role="menuitem" type="submit">Log out</button>
          </form>
        </div>
      </div>
    </div>
  </aside>
  <div class="sidebar-scrim" data-sidebar-close hidden></div>
  <div class="shell-body">
    <header class="topbar">
      <button class="topbar-menu" type="button" data-sidebar-open aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
      </button>
      <span class="topbar-section" aria-hidden="true">Catalog</span>
      <div class="topbar-spacer"></div>
      <div class="topbar-notifications" id="notification-bell" hx-get="/notifications/count" hx-trigger="load, every 45s [document.visibilityState === 'visible'], notifications:changed from:body" hx-target="this" hx-swap="innerHTML"><a class="bell-link" id="notification-bell-link" href="/notifications" hx-get="/notifications" hx-target="#notification-panel-host" hx-swap="innerHTML" title="Notifications" aria-label="Notifications">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
</a></div>
      <a class="btn primary topbar-new" href="/tickets/new">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        <span class="topbar-new-label">New ticket</span>
      </a>
    </header>
    <main class="main" id="main-content">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>

<div class="users-root categories-root" data-list-url="/categories"><div id="categories-background" class="catalog-screen">
  <header class="users-header command-header">
    <div>
      <h1 class="command-title">Catalog</h1>
      <p class="users-help">Group categories in folders. Each category&#39;s workflow decides which desk works it.</p>
    </div>
    <div class="command-actions">
      <button class="btn ghost" type="button" data-catalog-header-create="category" hidden>New category</button>
      <button class="btn ghost" type="button" data-catalog-header-create="folder" hidden>New folder</button>
      <button class="btn ghost" type="button" data-catalog-expand-toggle data-expand-label="Expand all" data-collapse-label="Collapse all">Collapse all</button>
      <noscript>
      <a class="btn ghost category-drawer-launcher" data-focus-key="new-category" data-catalog-create="category" href="/categories/new?folder_id=1&amp;folder=1" hx-get="/categories/new?folder_id=1&amp;folder=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/new?folder_id=1&amp;folder=1">New category</a>
      <a class="btn primary category-drawer-launcher" data-catalog-new-toggle data-focus-key="new-folder" data-catalog-create="folder" href="/categories/folders/new?parent_id=1&amp;folder=1" hx-get="/categories/folders/new?parent_id=1&amp;folder=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/folders/new?parent_id=1&amp;folder=1">New folder</a>
      </noscript>
    </div>
  </header>

  <div class="catalog-toolbar">
    <form class="category-search search-field" method="get" action="/categories" role="search">
      <label class="visually-hidden" for="category-search">Search folders and categories</label>
      <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
      <input id="category-search" type="search" name="q" value="" placeholder="Search folders and categories" autocomplete="off">
      <input type="hidden" name="folder" value="1">
      <button class="visually-hidden" type="submit">Search</button>
    </form>
    <a class="catalog-attention-chip" href="/categories?attention=1&amp;folder=1">Needs attention · 1</a>
  </div>
  <template id="catalog-move-folders"></template>
  <div class="catalog-workspace">
  <section class="catalog-tree-region" aria-labelledby="catalog-tree-title">
    <h2 id="catalog-tree-title" class="visually-hidden">Catalog structure</h2>
    <div class="catalog-tree catalog-folder-tree">
      <ul class="catalog-tree-list catalog-tree-root" data-create-folder-url="/categories/folders" data-create-category-url="/categories" role="tree" aria-label="Catalog structure">
<li class="catalog-tree-node catalog-tree-folder" data-catalog-node data-catalog-slug="f3" data-catalog-id="3" data-level="folder" data-depth="1" role="treeitem" aria-level="1" aria-selected="false" aria-expanded="true" data-parent-id="0" data-name="Facilities" data-rename-url="/categories/folders/3/rename" data-move-url="/categories/folders/3/move" data-details-url="/categories/folders/3/details" data-delete-url="/categories/folders/3/delete" data-create-folder-url="/categories/folders" data-create-category-url="/categories">
  <div class="catalog-tree-row catalog-tree-row-folder">
    <span class="catalog-disclosure catalog-disclosure-empty" aria-hidden="true"></span>
    <svg class="catalog-node-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h6l2 2.5H20a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/></svg>
    <span class="catalog-node-main"><span id="catalog-name-folder-3" class="catalog-node-name">Facilities</span></span>
    <span class="catalog-node-spacer"></span>
    <div class="catalog-row-actions"><button class="category-menu-button catalog-add-button" type="button" data-catalog-add aria-label="Create in Facilities" title="Create in Facilities"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
    <button class="category-menu-button catalog-details-button" type="button" data-catalog-pen aria-label="Properties for Facilities" title="Properties for Facilities"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L18.5 9.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 8.5l2 2"/></svg></button><div class="category-overflow catalog-row-menu"><button class="category-menu-button" type="button" data-category-menu data-focus-key="folder-actions-3" aria-controls="folder-menu-3" aria-expanded="false" aria-label="Actions for Facilities" title="Actions for Facilities"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" stroke="none" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg></button><div id="folder-menu-3" class="category-overflow-menu" role="menu" hidden><a class="category-drawer-launcher" data-catalog-create="folder" role="menuitem" href="/categories/folders/new?parent_id=3&amp;folder=1" hx-get="/categories/folders/new?parent_id=3&amp;folder=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/folders/new?parent_id=3&amp;folder=1">New folder</a><a class="category-drawer-launcher" data-catalog-create="category" role="menuitem" href="/categories/new?folder_id=3&amp;folder=1" hx-get="/categories/new?folder_id=3&amp;folder=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/new?folder_id=3&amp;folder=1">New category</a><a class="category-drawer-launcher" data-catalog-cut role="menuitem" href="/categories/folders/3/move?folder=1" hx-get="/categories/folders/3/move?folder=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/folders/3/move?folder=1">Move…</a><form method="post" action="/categories/folders/3/delete" hx-post="/categories/folders/3/delete" hx-target="#categories-background" hx-swap="outerHTML" role="none"><input type="hidden" name="folder" value="1"><button class="category-menu-danger" role="menuitem" data-category-delete="folder" data-delete-confirm="Delete the folder “Facilities”?" type="submit">Delete folder</button></form></div></div></div><noscript><a href="/categories/folders/3/edit">Rename folder</a> <a href="/categories/folders/3/move">Move…</a></noscript>
  </div>
</li><li class="catalog-tree-node catalog-tree-folder" data-catalog-node data-catalog-slug="f1" data-catalog-id="1" data-level="folder" data-depth="1" role="treeitem" aria-level="1" aria-selected="false" aria-expanded="true" data-parent-id="0" data-name="IT services" data-rename-url="/categories/folders/1/rename" data-move-url="/categories/folders/1/move" data-details-url="/categories/folders/1/details" data-delete-url="/categories/folders/1/delete" data-create-folder-url="/categories/folders" data-create-category-url="/categories">
  <div class="catalog-tree-row catalog-tree-row-folder">
    <button class="catalog-disclosure" type="button" data-catalog-disclosure aria-expanded="true" aria-controls="catalog-f1" aria-label="Collapse IT services" data-catalog-name="IT services"><span class="catalog-disclosure-mark" aria-hidden="true"></span></button>
    <svg class="catalog-node-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h6l2 2.5H20a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/></svg>
    <span class="catalog-node-main"><span id="catalog-name-folder-1" class="catalog-node-name">IT services</span><span class="catalog-node-sub">Laptops and access</span></span>
    <span class="catalog-node-spacer"></span>
    <div class="catalog-row-actions"><button class="category-menu-button catalog-add-button" type="button" data-catalog-add aria-label="Create in IT services" title="Create in IT services"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
    <button class="category-menu-button catalog-details-button" type="button" data-catalog-pen aria-label="Properties for IT services" title="Properties for IT services"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L18.5 9.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 8.5l2 2"/></svg></button><div class="category-overflow catalog-row-menu"><button class="category-menu-button" type="button" data-category-menu data-focus-key="folder-actions-1" aria-controls="folder-menu-1" aria-expanded="false" aria-label="Actions for IT services" title="Actions for IT services"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" stroke="none" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg></button><div id="folder-menu-1" class="category-overflow-menu" role="menu" hidden><a class="category-drawer-launcher" data-catalog-create="folder" role="menuitem" href="/categories/folders/new?parent_id=1&amp;folder=1" hx-get="/categories/folders/new?parent_id=1&amp;folder=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/folders/new?parent_id=1&amp;folder=1">New folder</a><a class="category-drawer-launcher" data-catalog-create="category" role="menuitem" href="/categories/new?folder_id=1&amp;folder=1" hx-get="/categories/new?folder_id=1&amp;folder=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/new?folder_id=1&amp;folder=1">New category</a><a class="category-drawer-launcher" data-catalog-cut role="menuitem" href="/categories/folders/1/move?folder=1" hx-get="/categories/folders/1/move?folder=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/folders/1/move?folder=1">Move…</a><form method="post" action="/categories/folders/1/delete" hx-post="/categories/folders/1/delete" hx-target="#categories-background" hx-swap="outerHTML" role="none"><input type="hidden" name="folder" value="1"><button class="category-menu-danger" role="menuitem" data-category-delete="folder" data-delete-confirm="Delete the folder “IT services”?" type="submit">Delete folder</button></form></div></div></div><noscript><a href="/categories/folders/1/edit">Rename folder</a> <a href="/categories/folders/1/move">Move…</a></noscript>
  </div>
  <ul class="catalog-tree-list" role="group" id="catalog-f1" aria-label="IT services">
<li class="catalog-tree-node catalog-tree-folder" data-catalog-node data-catalog-slug="f2" data-catalog-id="2" data-level="folder" data-depth="2" role="treeitem" aria-level="2" aria-selected="false" aria-expanded="true" data-parent-id="1" data-name="Hardware" data-rename-url="/categories/folders/2/rename" data-move-url="/categories/folders/2/move" data-details-url="/categories/folders/2/details" data-delete-url="/categories/folders/2/delete" data-create-folder-url="/categories/folders" data-create-category-url="/categories">
  <div class="catalog-tree-row catalog-tree-row-folder">
    <span class="catalog-disclosure catalog-disclosure-empty" aria-hidden="true"></span>
    <svg class="catalog-node-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h6l2 2.5H20a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/></svg>
    <span class="catalog-node-main"><span id="catalog-name-folder-2" class="catalog-node-name">Hardware</span></span>
    <span class="catalog-node-spacer"></span>
    <div class="catalog-row-actions"><button class="category-menu-button catalog-add-button" type="button" data-catalog-add aria-label="Create in Hardware" title="Create in Hardware"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
    <button class="category-menu-button catalog-details-button" type="button" data-catalog-pen aria-label="Properties for Hardware" title="Properties for Hardware"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L18.5 9.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 8.5l2 2"/></svg></button><div class="category-overflow catalog-row-menu"><button class="category-menu-button" type="button" data-category-menu data-focus-key="folder-actions-2" aria-controls="folder-menu-2" aria-expanded="false" aria-label="Actions for Hardware" title="Actions for Hardware"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" stroke="none" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg></button><div id="folder-menu-2" class="category-overflow-menu" role="menu" hidden><a class="category-drawer-launcher" data-catalog-create="folder" role="menuitem" href="/categories/folders/new?parent_id=2&amp;folder=1" hx-get="/categories/folders/new?parent_id=2&amp;folder=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/folders/new?parent_id=2&amp;folder=1">New folder</a><a class="category-drawer-launcher" data-catalog-create="category" role="menuitem" href="/categories/new?folder_id=2&amp;folder=1" hx-get="/categories/new?folder_id=2&amp;folder=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/new?folder_id=2&amp;folder=1">New category</a><a class="category-drawer-launcher" data-catalog-cut role="menuitem" href="/categories/folders/2/move?folder=1" hx-get="/categories/folders/2/move?folder=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/folders/2/move?folder=1">Move…</a><form method="post" action="/categories/folders/2/delete" hx-post="/categories/folders/2/delete" hx-target="#categories-background" hx-swap="outerHTML" role="none"><input type="hidden" name="folder" value="1"><button class="category-menu-danger" role="menuitem" data-category-delete="folder" data-delete-confirm="Delete the folder “Hardware”?" type="submit">Delete folder</button></form></div></div></div><noscript><a href="/categories/folders/2/edit">Rename folder</a> <a href="/categories/folders/2/move">Move…</a></noscript>
  </div>
</li><li class="catalog-tree-node catalog-tree-category" data-catalog-id="2" data-level="category" data-depth="2" role="treeitem" aria-level="2" aria-selected="false" data-parent-id="1" data-name="Access" data-rename-url="/categories/2/rename" data-move-url="/categories/2/move" data-details-url="/categories/2/details" data-delete-url="/categories/2/delete">
  <div class="catalog-tree-row catalog-tree-row-category">
    <span class="catalog-disclosure catalog-disclosure-empty" aria-hidden="true"></span>
    <svg class="catalog-node-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.6 2.6A2 2 0 0 0 11.2 2H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l8.7 8.7a2.4 2.4 0 0 0 3.4 0l6.6-6.6a2.4 2.4 0 0 0 0-3.4z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
    <span class="catalog-node-main"><a id="catalog-name-category-2" class="catalog-node-name catalog-category-link" href="/categories/2/workflow">Access</a><span class="catalog-node-sub">Accounts and passwords</span></span>
