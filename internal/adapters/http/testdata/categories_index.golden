            <svg class="catalog-node-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h6l2 2.5H20a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/></svg>
            <span class="catalog-node-name">Support</span>
            <span class="catalog-node-description">Customer support</span>
            <span class="catalog-node-meta">1 desk</span>
            <span class="catalog-node-spacer"></span>
            <div class="category-overflow catalog-row-menu"><button class="category-menu-button" type="button" data-category-menu data-focus-key="department-actions-2" aria-controls="department-menu-2" aria-expanded="false" aria-label="Actions for Support">⋯</button><div id="department-menu-2" class="category-overflow-menu" role="menu" hidden><a class="category-drawer-launcher" role="menuitem" href="/categories/departments/2/edit?view=structure&department_id=2" hx-get="/categories/departments/2/edit?view=structure&department_id=2" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/departments/2/edit?view=structure&department_id=2">Edit department</a><a class="category-drawer-launcher" role="menuitem" href="/categories/desks/new?view=structure&department_id=2" hx-get="/categories/desks/new?view=structure&department_id=2" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/desks/new?view=structure&department_id=2">Add desk</a><form method="post" action="/categories/departments/2/delete" hx-post="/categories/departments/2/delete" hx-target="#categories-background" hx-swap="outerHTML" role="none"><input type="hidden" name="view" value="structure"><input type="hidden" name="department_id" value="2"><button class="category-menu-danger" role="menuitem" data-category-delete="department" data-delete-confirm="Delete the department “Support”?" type="submit">Delete department</button></form></div></div>
