<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="htmx-config" content='{"refreshOnHistoryMiss":true}'>
<title>Categories · tkt</title>

<link rel="stylesheet" href="/static/users.css"><script src="/static/categories.js" defer></script><script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script><script src="/static/notifications.js" defer></script><script src="/static/shell.js" defer></script>
</head>
<body class="users-page-body ">
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="shell">
  <aside class="sidebar" id="sidebar" aria-label="Sidebar">
    <div class="sidebar-brand">
      <a class="brand-mark" href="/tickets" aria-label="tkt">tkt</a>
      <a class="brand-text" href="/tickets" tabindex="-1" aria-hidden="true"><span class="brand-name">tkt</span><span class="brand-product">Help desk</span></a>
      <button class="sidebar-close" type="button" data-sidebar-close aria-label="Close menu">×</button>
    </div>
    <nav class="sidebar-nav" aria-label="Sections">
      <div class="sidebar-group">
        <span class="sidebar-group-label">Work</span>
        <a class="sidebar-link" href="/tickets" data-tip="Tickets">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
          <span class="sidebar-label">Tickets</span>
        </a>
      </div>
    </nav>
    <div class="sidebar-foot">
      <button class="sidebar-collapse" type="button" data-sidebar-collapse aria-pressed="false" data-tip="Expand sidebar" data-label-collapse="Collapse sidebar" data-label-expand="Expand sidebar" aria-keyshortcuts="[">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 7l-5 5 5 5"/><path d="M18 7l-5 5 5 5"/></svg>
        <span class="sidebar-label">Collapse sidebar</span>
      </button>
      <div class="sidebar-user">
        <button class="sidebar-user-button" type="button" data-user-menu-toggle aria-haspopup="menu" aria-expanded="false" aria-controls="user-menu" data-tip="Ana Torres">
          <span class="sidebar-avatar" aria-hidden="true">AT</span>
          <span class="sidebar-label sidebar-user-text"><span class="sidebar-user-name">Ana Torres</span><span class="sidebar-user-role"></span></span>
          <svg class="sidebar-user-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 14l6-6 6 6"/></svg>
        </button>
        <div class="user-menu" id="user-menu" role="menu" aria-label="Ana Torres" hidden>
          <a class="user-menu-item" role="menuitem" href="/preferences">Preferences</a>
          <form class="user-menu-logout" method="post" action="/logout">
            <button class="user-menu-item" role="menuitem" type="submit">Log out</button>
          </form>
        </div>
      </div>
    </div>
  </aside>
  <div class="sidebar-scrim" data-sidebar-close hidden></div>
  <div class="shell-body">
    <header class="topbar">
      <button class="topbar-menu" type="button" data-sidebar-open aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
      </button>
      <span class="topbar-section" aria-hidden="true">Categories</span>
      <div class="topbar-spacer"></div>
      <div class="topbar-notifications" id="notification-bell" hx-get="/notifications/count" hx-trigger="load, every 45s [document.visibilityState === 'visible'], notifications:changed from:body" hx-target="this" hx-swap="innerHTML"><a class="bell-link" id="notification-bell-link" href="/notifications" hx-get="/notifications" hx-target="#notification-panel-host" hx-swap="innerHTML" title="Notifications" aria-label="Notifications">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
</a></div>
      <a class="btn primary topbar-new" href="/tickets/new">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        <span class="topbar-new-label">New ticket</span>
      </a>
    </header>
    <main class="main" id="main-content">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>

<div class="users-root categories-root"><div id="categories-background">
  <header class="users-header command-header">
    <div>
      <h1 class="command-title">Categories</h1>
      <p class="command-sub">Manage the Department, Desk, and Category hierarchy</p>
    </div>

  </header>
  <nav class="category-mobile-actions" aria-label="Catalog creation">
<a class="btn primary category-drawer-launcher" href="/categories/departments/new?view=structure" hx-get="/categories/departments/new?view=structure" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/departments/new?view=structure">New department</a>
<a class="btn primary category-drawer-launcher" href="/categories/desks/new?view=structure&department_id=1" hx-get="/categories/desks/new?view=structure&department_id=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/desks/new?view=structure&department_id=1">New desk</a>
<a class="btn primary category-drawer-launcher" href="/categories/new?view=structure&department_id=1&desk_id=1" hx-get="/categories/new?view=structure&department_id=1&desk_id=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/new?view=structure&department_id=1&desk_id=1">New category</a>
  </nav>

<form class="category-search search-field" method="get" action="/categories" role="search">
  <label class="visually-hidden" for="category-search">Search departments, desks, or categories</label>
  <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
  <input id="category-search" type="search" name="q" value="" placeholder="Search departments, desks, or categories" autocomplete="off">
  <input type="hidden" name="view" value=""><input type="hidden" name="department_id" value="1"><input type="hidden" name="desk_id" value="1">
  <button class="visually-hidden" type="submit">Search</button>
</form>

  <div class="category-structure" aria-label="Catalog structure">
    <section class="category-level category-level-departments " aria-labelledby="departments-title">
      <header><div><p class="category-level-eyebrow">Departments</p><h2 id="departments-title">Departments</h2></div><a class="btn primary category-level-action category-drawer-launcher" data-focus-key="new-department" href="/categories/departments/new?view=structure" hx-get="/categories/departments/new?view=structure" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/departments/new?view=structure">New department</a></header>
      <div class="category-level-list">

        <div class="category-structure-item"><a class="category-structure-row is-selected" href="/categories?view=structure&department_id=1" aria-current="true"><span><strong>Technology</strong><small>Engineering and platform</small><span class="category-count">2 desks</span></span></a><div class="category-overflow category-structure-menu"><button class="category-menu-button" type="button" data-category-menu data-focus-key="department-actions-Technology" aria-controls="department-menu-1" aria-expanded="false" aria-label="Actions for Technology">⋯</button><div id="department-menu-1" class="category-overflow-menu" role="menu" hidden><a class="category-drawer-launcher" role="menuitem" href="/categories/departments/1/edit?view=structure&department_id=1" hx-get="/categories/departments/1/edit?view=structure&department_id=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/departments/1/edit?view=structure&department_id=1">Edit department</a><form method="post" action="/categories/departments/1/delete" hx-post="/categories/departments/1/delete" hx-target="#categories-background" hx-swap="outerHTML" role="none"><input type="hidden" name="view" value="structure"><input type="hidden" name="department_id" value="1"><button class="category-menu-danger" role="menuitem" data-category-delete="department" data-delete-confirm="Delete the department “Technology”?" type="submit">Delete department</button></form></div></div></div>

        <div class="category-structure-item"><a class="category-structure-row " href="/categories?view=structure&department_id=2" aria-current=""><span><strong>Support</strong><small>Customer support</small><span class="category-count">1 desk</span></span></a><div class="category-overflow category-structure-menu"><button class="category-menu-button" type="button" data-category-menu data-focus-key="department-actions-Support" aria-controls="department-menu-2" aria-expanded="false" aria-label="Actions for Support">⋯</button><div id="department-menu-2" class="category-overflow-menu" role="menu" hidden><a class="category-drawer-launcher" role="menuitem" href="/categories/departments/2/edit?view=structure&department_id=2" hx-get="/categories/departments/2/edit?view=structure&department_id=2" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/departments/2/edit?view=structure&department_id=2">Edit department</a><form method="post" action="/categories/departments/2/delete" hx-post="/categories/departments/2/delete" hx-target="#categories-background" hx-swap="outerHTML" role="none"><input type="hidden" name="view" value="structure"><input type="hidden" name="department_id" value="2"><button class="category-menu-danger" role="menuitem" data-category-delete="department" data-delete-confirm="Delete the department “Support”?" type="submit">Delete department</button></form></div></div></div>

      </div>
    </section>
    <section class="category-level category-level-desks " aria-labelledby="desks-title">
      <header><div><p class="category-level-eyebrow">Desks</p><h2 id="desks-title">Desks</h2></div><a class="btn primary category-level-action category-drawer-launcher" data-focus-key="new-desk" href="/categories/desks/new?view=structure&department_id=1" hx-get="/categories/desks/new?view=structure&department_id=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/desks/new?view=structure&department_id=1">New desk</a></header>
      <div class="category-level-context"><a class="category-mobile-back" href="/categories?view=structure">← Departments</a></div>
      <div class="category-level-list">

        <div class="category-structure-item"><a class="category-structure-row is-selected" href="/categories?view=structure&department_id=1&desk_id=1" aria-current="true"><span><strong>Service desk</strong><small>First-line triage</small><span class="category-count">2 categories</span></span></a><div class="category-overflow category-structure-menu"><button class="category-menu-button" type="button" data-category-menu data-focus-key="desk-actions-1" aria-controls="desk-menu-1" aria-expanded="false" aria-label="Actions for Service desk">⋯</button><div id="desk-menu-1" class="category-overflow-menu" role="menu" hidden><a class="category-drawer-launcher" role="menuitem" href="/categories/desks/1/edit?view=structure&department_id=1&desk_id=1" hx-get="/categories/desks/1/edit?view=structure&department_id=1&desk_id=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/desks/1/edit?view=structure&department_id=1&desk_id=1">Edit desk</a><form method="post" action="/categories/desks/1/delete" hx-post="/categories/desks/1/delete" hx-target="#categories-background" hx-swap="outerHTML" role="none"><input type="hidden" name="view" value="structure"><input type="hidden" name="department_id" value="1"><input type="hidden" name="desk_id" value="1"><button class="category-menu-danger" role="menuitem" data-category-delete="desk" data-delete-confirm="Delete the desk “Service desk”?" type="submit">Delete desk</button></form></div></div></div>

        <div class="category-structure-item"><a class="category-structure-row " href="/categories?view=structure&department_id=1&desk_id=2" aria-current=""><span><strong>Platform</strong><small>Infrastructure</small><span class="category-count">0 categories</span></span></a><div class="category-overflow category-structure-menu"><button class="category-menu-button" type="button" data-category-menu data-focus-key="desk-actions-2" aria-controls="desk-menu-2" aria-expanded="false" aria-label="Actions for Platform">⋯</button><div id="desk-menu-2" class="category-overflow-menu" role="menu" hidden><a class="category-drawer-launcher" role="menuitem" href="/categories/desks/2/edit?view=structure&department_id=1&desk_id=2" hx-get="/categories/desks/2/edit?view=structure&department_id=1&desk_id=2" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/desks/2/edit?view=structure&department_id=1&desk_id=2">Edit desk</a><form method="post" action="/categories/desks/2/delete" hx-post="/categories/desks/2/delete" hx-target="#categories-background" hx-swap="outerHTML" role="none"><input type="hidden" name="view" value="structure"><input type="hidden" name="department_id" value="1"><input type="hidden" name="desk_id" value="2"><button class="category-menu-danger" role="menuitem" data-category-delete="desk" data-delete-confirm="Delete the desk “Platform”?" type="submit">Delete desk</button></form></div></div></div>

      </div>
    </section>
    <section class="category-level category-level-categories is-current" aria-labelledby="structure-categories-title">
      <header><div><p class="category-level-eyebrow">Categories</p><h2 id="structure-categories-title">Categories</h2></div><a class="btn primary category-level-action category-drawer-launcher" data-focus-key="new-category" href="/categories/new?view=structure&department_id=1&desk_id=1" hx-get="/categories/new?view=structure&department_id=1&desk_id=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/new?view=structure&department_id=1&desk_id=1">New category</a></header>
      <div class="category-level-context"><a class="category-mobile-back" href="/categories?view=structure&department_id=1">← Desks</a></div>
      <div class="category-level-list category-level-list-table">
        <table class="category-table">
          <thead><tr>
            <th class="category-table-name" scope="col">Category</th>
            <th class="category-table-flow" scope="col">Workflow</th>
            <th class="category-table-num" scope="col">Open</th>
            <th class="category-table-act" scope="col"><span class="visually-hidden">Actions</span></th>
          </tr></thead>
          <tbody>

            <tr>
              <td class="category-table-name" data-label="Category"><a class="category-name" href="/categories/1/workflow"><strong>Bugs</strong></a><small>Defects and regressions</small></td>
              <td class="category-table-flow" data-label="Workflow"><span class="category-status-inline">Published v1</span></td>
              <td class="category-table-num" data-label="Open">3</td>
              <td class="category-table-act" data-label="Actions"><div class="category-overflow category-structure-menu"><button class="category-menu-button" type="button" data-category-menu data-focus-key="category-actions-Bugs" aria-controls="structure-category-menu-1" aria-expanded="false" aria-label="Actions for Bugs">⋯</button><div id="structure-category-menu-1" class="category-overflow-menu" role="menu" hidden><a class="category-drawer-launcher" role="menuitem" href="/categories/1/edit?view=structure&department_id=1&desk_id=1" hx-get="/categories/1/edit?view=structure&department_id=1&desk_id=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/1/edit?view=structure&department_id=1&desk_id=1">Edit category</a><a role="menuitem" href="/categories/1/workflow">Configure workflow</a><a role="menuitem" href="/categories/1/sla">Configure SLA</a><form method="post" action="/categories/1/delete" hx-post="/categories/1/delete" hx-target="#categories-background" hx-swap="outerHTML" role="none"><input type="hidden" name="view" value="structure"><input type="hidden" name="department_id" value="1"><input type="hidden" name="desk_id" value="1"><button class="category-menu-danger" role="menuitem" data-category-delete="category" data-delete-confirm="Delete the category “Bugs”?" type="submit">Delete category</button></form></div></div></td>
            </tr>

            <tr>
              <td class="category-table-name" data-label="Category"><a class="category-name" href="/categories/2/workflow"><strong>Support</strong></a><small>Customer questions</small></td>
              <td class="category-table-flow" data-label="Workflow"><span class="category-status-inline">Draft · not published</span></td>
              <td class="category-table-num" data-label="Open">1</td>
              <td class="category-table-act" data-label="Actions"><div class="category-overflow category-structure-menu"><button class="category-menu-button" type="button" data-category-menu data-focus-key="category-actions-Support" aria-controls="structure-category-menu-2" aria-expanded="false" aria-label="Actions for Support">⋯</button><div id="structure-category-menu-2" class="category-overflow-menu" role="menu" hidden><a class="category-drawer-launcher" role="menuitem" href="/categories/2/edit?view=structure&department_id=1&desk_id=1" hx-get="/categories/2/edit?view=structure&department_id=1&desk_id=1" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/2/edit?view=structure&department_id=1&desk_id=1">Edit category</a><a role="menuitem" href="/categories/2/workflow">Configure workflow</a><a role="menuitem" href="/categories/2/sla">Configure SLA</a><form method="post" action="/categories/2/delete" hx-post="/categories/2/delete" hx-target="#categories-background" hx-swap="outerHTML" role="none"><input type="hidden" name="view" value="structure"><input type="hidden" name="department_id" value="1"><input type="hidden" name="desk_id" value="1"><button class="category-menu-danger" role="menuitem" data-category-delete="category" data-delete-confirm="Delete the category “Support”?" type="submit">Delete category</button></form></div></div></td>
            </tr>

          </tbody>
        </table>
      </div>
    </section>
  </div>
</div><div id="category-drawer-host"></div>
<dialog id="category-delete-dialog" aria-labelledby="category-delete-title" aria-describedby="category-delete-copy">
  <h2 id="category-delete-title"></h2>
  <p id="category-delete-copy">This cannot be undone.</p>
  <div><button type="button" data-category-delete-cancel>Cancel</button><button type="button" data-category-delete-confirm>Delete</button></div>
</dialog>
</div>
</main>
    <nav class="tabbar" aria-label="Sections">
      <a class="tabbar-item" href="/tickets">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
        <span>Tickets</span>
      </a>
      <a class="tabbar-item" href="/notifications">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
        <span>Notifications</span>
      </a>
      <button class="tabbar-item" type="button" data-sidebar-open aria-controls="sidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
        <span>More</span>
      </button>
    </nav>
  </div>
  <div class="notification-panel-host" id="notification-panel-host"></div>
</div>
</body>
</html>
