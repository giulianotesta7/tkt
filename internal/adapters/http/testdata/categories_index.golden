<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>tkt — Ticket Desk</title>

<script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script>
</head>
<body>
<div class="layout">
  <aside class="rail">
    <a class="rail-brand" href="/tickets" title="tkt">tkt</a>
    <nav class="rail-nav">
      <a class="rail-link" href="/tickets" title="Tickets" aria-label="Tickets">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
      </a>



    </nav>
    <div class="rail-operator" title="Ana Torres">AT</div>
    <form class="rail-logout" method="post" action="/logout">
      <button class="rail-link" type="submit" title="Log out" aria-label="Log out">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3"/><path d="M15 8l4 4-4 4"/><path d="M19 12H9"/></svg>
      </button>
    </form>
  </aside>
  <main class="main">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>

<div class="users-root categories-root"><div id="categories-background">
  <header class="users-header command-header">
    <div>
      <h1 class="command-title">Categories</h1>
      <p class="command-sub">Manage the Department, Desk, and Category hierarchy</p>
    </div>

  </header>
  <nav class="category-mobile-actions" aria-label="Catalog creation">
<a class="btn primary category-drawer-launcher" href="/categories/departments/new?view=structure" hx-get="/categories/departments/new?view=structure" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/departments/new?view=structure">New department</a>
<a class="btn primary category-drawer-launcher" href="/categories/desks/new?view=structure" hx-get="/categories/desks/new?view=structure" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/desks/new?view=structure">New desk</a>
<a class="btn primary category-drawer-launcher" href="/categories/new?view=structure" hx-get="/categories/new?view=structure" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/new?view=structure">New category</a>
  </nav>

<form class="category-search search-field" method="get" action="/categories" role="search">
  <label class="visually-hidden" for="category-search">Search departments, desks, or categories</label>
  <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
  <input id="category-search" type="search" name="q" value="" placeholder="Search departments, desks, or categories" autocomplete="off">
  <input type="hidden" name="view" value="">
  <button class="visually-hidden" type="submit">Search</button>
</form>

  <div class="category-structure" aria-label="Catalog structure">
    <section class="category-level category-level-departments is-current" aria-labelledby="departments-title">
      <header><div><p class="category-level-eyebrow">Departments</p><h2 id="departments-title">Departments</h2></div><a class="btn primary category-level-action category-drawer-launcher" data-focus-key="new-department" href="/categories/departments/new?view=structure" hx-get="/categories/departments/new?view=structure" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/departments/new?view=structure">New department</a></header>
      <div class="category-level-list">
        <p class="category-empty">No departments yet.</p>
      </div>
    </section>
    <section class="category-level category-level-desks " aria-labelledby="desks-title">
      <header><div><p class="category-level-eyebrow">Desks</p><h2 id="desks-title">Desks</h2></div><a class="btn primary category-level-action category-drawer-launcher" data-focus-key="new-desk" href="/categories/desks/new?view=structure" hx-get="/categories/desks/new?view=structure" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/desks/new?view=structure">New desk</a></header>
      <div class="category-level-context"><span>Select a department</span></div>
      <div class="category-level-list">
        <p class="category-empty">Select a department to browse desks.</p>
      </div>
    </section>
    <section class="category-level category-level-categories " aria-labelledby="structure-categories-title">
      <header><div><p class="category-level-eyebrow">Categories</p><h2 id="structure-categories-title">Categories</h2></div><a class="btn primary category-level-action category-drawer-launcher" data-focus-key="new-category" href="/categories/new?view=structure" hx-get="/categories/new?view=structure" hx-target="#category-drawer-host" hx-swap="outerHTML" hx-push-url="/categories/new?view=structure">New category</a></header>
      <div class="category-level-context"><span>Select a desk</span></div>
      <div class="category-level-list">
        <p class="category-empty">Select a desk to browse categories.</p>
      </div>
    </section>
  </div>
</div><div id="category-drawer-host"></div>
</div>
</main>
</div>
</body>
</html>
