<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="htmx-config" content='{"refreshOnHistoryMiss":true}'>
<title>tkt — Ticket Desk</title>

<script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script><script src="/static/notifications.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="layout">
  <aside class="rail">
    <a class="rail-brand" href="/tickets" title="tkt">tkt</a>
    <nav class="rail-nav">
      <div class="rail-notifications" id="notification-bell" hx-get="/notifications/count" hx-trigger="load, every 45s [document.visibilityState === 'visible'], notifications:changed from:body" hx-target="this" hx-swap="innerHTML"><a class="rail-link" id="notification-bell-link" href="/notifications" hx-get="/notifications" hx-target="#notification-panel-host" hx-swap="innerHTML" title="Notifications" aria-label="Notifications">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 5-2.5 6.5-2.5 6.5h17S18 14 18 9z"/><path d="M10.4 19.5a2 2 0 0 0 3.2 0"/></svg>
</a></div>
      <a class="rail-link" href="/tickets" title="Tickets" aria-label="Tickets">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
      </a>



      <a class="rail-link" href="/preferences" title="Preferences" aria-label="Preferences">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="8" x2="21" y2="8"/><circle cx="9" cy="8" r="2.2"/><line x1="3" y1="16" x2="21" y2="16"/><circle cx="15" cy="16" r="2.2"/></svg>
      </a>
    </nav>
    <div class="rail-operator" title="Ana Torres">AT</div>
    <form class="rail-logout" method="post" action="/logout">
      <button class="rail-link" type="submit" title="Log out" aria-label="Log out">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3"/><path d="M15 8l4 4-4 4"/><path d="M19 12H9"/></svg>
      </button>
    </form>
  </aside>
  <div class="notification-panel-host" id="notification-panel-host"></div>
  <main class="main" id="main-content">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>

<div class="command-header">
  <div>
    <h1 class="command-title">Notifications</h1>
  </div>
</div>
<div class="card notifications-page">
<form class="notifications-actions" method="post" action="/notifications/read-all">
  <button class="btn" type="submit">Mark all as read</button>
</form>
  <div class="notifications-body"><ul class="notifications-groups">
  <li class="notifications-group">
    <h3 class="notifications-day">Today</h3>
    <ul class="notifications-rows">
      <li class="notifications-row"><form method="post" action="/notifications/12/read">
  <input type="hidden" name="ticket_id" value="12">
  <button class="notification-open" type="submit">
    <span class="notification-ident">TKT-15 · Monitor flickers on the dock</span>
    <span class="notification-what">Your ticket will be closed tomorrow unless you reply</span>
    <span class="notification-meta">Automatic · <time datetime="2026-08-06T10:30:00Z">10:30 · 06 Aug</time> <span class="notification-unread">Unread</span></span>
  </button>
</form></li>
      <li class="notifications-row"><form method="post" action="/notifications/11/read">
  <input type="hidden" name="ticket_id" value="11">
  <button class="notification-open" type="submit">
    <span class="notification-ident">TKT-14 · Headset microphone is mute</span>
    <span class="notification-what">Closed because there was no reply</span>
    <span class="notification-meta">Automatic · <time datetime="2026-08-06T10:30:00Z">10:30 · 06 Aug</time> <span class="notification-unread">Unread</span></span>
  </button>
</form></li>
      <li class="notifications-row"><form method="post" action="/notifications/10/read">
  <input type="hidden" name="ticket_id" value="10">
  <button class="notification-open" type="submit">
    <span class="notification-ident">TKT-13 · Laptop will not boot</span>
    <span class="notification-what">Your ticket is on hold until you reply</span>
    <span class="notification-meta">Marco Ruiz · <time datetime="2026-08-06T10:30:00Z">10:30 · 06 Aug</time></span>
  </button>
</form></li>
      <li class="notifications-row"><form method="post" action="/notifications/9/read">
  <input type="hidden" name="ticket_id" value="9">
  <button class="notification-open" type="submit">
    <span class="notification-ident">TKT-12 · VPN drops every hour</span>
    <span class="notification-what">Assigned to you</span>
    <span class="notification-meta">Automatic · <time datetime="2026-08-06T10:30:00Z">10:30 · 06 Aug</time> <span class="notification-unread">Unread</span></span>
  </button>
</form></li>
      <li class="notifications-row"><form method="post" action="/notifications/8/read">
  <input type="hidden" name="ticket_id" value="8">
  <button class="notification-open" type="submit">
    <span class="notification-ident">TKT-11 · Invoice export misses August</span>
    <span class="notification-what">State changed from New to In Progress</span>
    <span class="notification-meta">Marco Ruiz · <time datetime="2026-08-06T10:00:00Z">10:00 · 06 Aug</time> <span class="notification-unread">Unread</span></span>
  </button>
</form></li>
      <li class="notifications-row"><form method="post" action="/notifications/7/read">
  <input type="hidden" name="ticket_id" value="7">
  <button class="notification-open" type="submit">
    <span class="notification-ident">TKT-10 · Printer jam on the third floor</span>
    <span class="notification-what">New comment</span>
    <span class="notification-meta">Ana Torres · <time datetime="2026-08-06T10:00:00Z">10:00 · 06 Aug</time></span>
  </button>
</form></li>
    </ul>
  </li>
  <li class="notifications-group">
    <h3 class="notifications-day">Yesterday</h3>
    <ul class="notifications-rows">
      <li class="notifications-row"><form method="post" action="/notifications/6/read">
  <input type="hidden" name="ticket_id" value="6">
  <button class="notification-open" type="submit">
    <span class="notification-ident">TKT-9 · Onboarding checklist is out of date</span>
    <span class="notification-what">Resolved, confirm whether it is solved</span>
    <span class="notification-meta">Marco Ruiz · <time datetime="2026-08-05T10:00:00Z">10:00 · 05 Aug</time> <span class="notification-unread">Unread</span></span>
  </button>
</form></li>
      <li class="notifications-row"><form method="post" action="/notifications/5/read">
  <input type="hidden" name="ticket_id" value="5">
  <button class="notification-open" type="submit">
    <span class="notification-ident">TKT-8 · Badge reader rejects new cards</span>
    <span class="notification-what">The requester confirmed the resolution</span>
    <span class="notification-meta">Unknown user · <time datetime="2026-08-05T10:00:00Z">10:00 · 05 Aug</time></span>
  </button>
</form></li>
      <li class="notifications-row"><form method="post" action="/notifications/4/read">
  <input type="hidden" name="ticket_id" value="4">
  <button class="notification-open" type="submit">
    <span class="notification-ident">TKT-7 · Laptop battery swells</span>
    <span class="notification-what">Priority changed from Medium to High</span>
    <span class="notification-meta">Ana Torres · <time datetime="2026-08-05T10:00:00Z">10:00 · 05 Aug</time> <span class="notification-unread">Unread</span></span>
  </button>
</form></li>
    </ul>
  </li>
  <li class="notifications-group">
    <h3 class="notifications-day"><time datetime="2026-07-28T10:00:00Z">Jul 28, 2026</time></h3>
    <ul class="notifications-rows">
      <li class="notifications-row"><form method="post" action="/notifications/3/read">
  <input type="hidden" name="ticket_id" value="3">
  <button class="notification-open" type="submit">
    <span class="notification-ident">TKT-6 · Mailbox quota warnings</span>
    <span class="notification-what">New internal comment</span>
    <span class="notification-meta">Marco Ruiz · <time datetime="2026-07-28T10:00:00Z">10:00 · 28 Jul</time> <span class="notification-unread">Unread</span></span>
  </button>
</form></li>
      <li class="notifications-row"><form method="post" action="/notifications/2/read">
  <input type="hidden" name="ticket_id" value="2">
  <button class="notification-open" type="submit">
    <span class="notification-ident">TKT-5 · Software request needs approval</span>
    <span class="notification-what">A workflow form step is waiting on you</span>
    <span class="notification-meta">Automatic · <time datetime="2026-07-28T10:00:00Z">10:00 · 28 Jul</time></span>
  </button>
</form></li>
      <li class="notifications-row"><form method="post" action="/notifications/1/read">
  <input type="hidden" name="ticket_id" value="1">
  <button class="notification-open" type="submit">
    <span class="notification-ident">Ticket no longer available</span>
    <span class="notification-what">The requester rejected the resolution</span>
    <span class="notification-meta">Ana Torres · <time datetime="2026-07-28T10:00:00Z">10:00 · 28 Jul</time></span>
  </button>
</form></li>
    </ul>
  </li>
</ul>
</div>
</div>
</main>
</div>
</body>
</html>
