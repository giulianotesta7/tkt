      <div class="meta-row">
        <a href="/tickets">← Queue</a>
        <span class="num">TKT-1</span>
      </div>

      <h1 class="command-title">Login page down</h1>

      <div class="meta-row ticket-metadata">
        <span>Created <time datetime="2026-08-06T10:00:00Z">10:00 · 06-08-2026</time></span>
        <span>Updated <time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time></span>
      </div>
    </div>
  </div>
  <div class="cards">
    <div class="conversation">
      <div class="card">
        <h2>Description</h2>
        <p>The login form 500s on submit</p>
          </div>


          <div class="card">
        <h2>Timeline</h2>

<div id="timeline">


  <div class="timeline-entry timeline-comment">
    <div class="who">
      <span class="author">Ana Torres</span>
      <span class="when"><time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time></span>
    </div>
    <div class="body">Patched and deployed</div>
  </div>



  <div class="timeline-entry timeline-event st-resolved">
    <span class="event-icon">›</span>
    <div class="body">
      <div class="main">Transition · State · In Progress → Resolved</div>

      <div class="when"><time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time> · Admin</div>
    </div>
  </div>



  <div class="timeline-entry timeline-event st-in_progress">
    <span class="event-icon">›</span>
    <div class="body">
      <div class="main">Transition · State · New → In Progress</div>

      <div class="when"><time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time> · Admin</div>
    </div>
  </div>



  <div class="timeline-entry timeline-event">
    <span class="event-icon">›</span>
    <div class="body">
      <div class="main">Created</div>

      <div class="when"><time datetime="2026-08-06T10:00:00Z">10:00 · 06-08-2026</time> · Beto Ruiz</div>
    </div>
  </div>


</div>

      </div>
    </div>
    <div class="evidence">
      <div class="prop-list">
        <div class="prop-section">
          <div class="prop-heading">Properties</div>
          <div class="prop-row">
            <span class="prop-label">Requester</span>
            <span class="prop-value">Beto Ruiz</span>
          </div>
          <div class="prop-row">
            <span class="prop-label">Category</span>
            <span id="ticket-category-value" class="prop-value">Bugs</span>
          </div>
          
        </div>
        <div class="prop-section">
          <div class="prop-heading">Assignment</div>

          <div class="prop-row">
            <span class="prop-label">Assignee</span>

            <span class="prop-value">Ana Torres</span>
            
          </div>

        </div>
        <div class="prop-section">
          <div class="prop-heading">State</div>
          <div class="prop-row">
            <span class="prop-label">Current</span>
            <span class="prop-value"><span class="badge resolved">Resolved</span></span>
          </div>

          <div class="prop-row">
            <span class="prop-label">Move to</span>
            <form class="prop-control transition-control" method="post" action="/tickets/1/transition"
                  hx-post="/tickets/1/transition" hx-target="#ticket-detail" hx-swap="outerHTML">
              <select id="ticket-state" name="to" class="prop-select"
                      aria-label="Move to state" onchange="toggleStateReason(this)">
                <option value="" disabled selected>Select…</option>
                <option value="in_progress" data-needs-reason>In Progress (reason required)</option>
              </select>
              <div id="state-reason-field" class="state-reason-field">
                <label for="state-reason">Reopen reason</label>
                <div class="state-reason-row">
                  <input type="text" id="state-reason" name="reason" class="state-reason"
                         placeholder="Required" required>
                  <button type="submit" id="state-apply" class="btn primary small state-apply">Apply</button>
                </div>
              </div>
            </form>
          </div>


          <dl class="lifecycle-meta">
            <dt>Resolved</dt><dd><time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time></dd>


          </dl>

        </div>
      </div>
    </div>
  </div>
</div>
<script>





function syncStateReason(select, autoSubmit) {
  const field = document.getElementById('state-reason-field');
  const reason = document.getElementById('state-reason');
  if (!field || !reason) return;
  const opt = select && select.options[select.selectedIndex];
  const needs = opt && opt.hasAttribute('data-needs-reason');
  field.classList.toggle('visible', !!needs);
  reason.required = !!needs;
  if (needs) {
    reason.focus();
  } else if (autoSubmit && opt && opt.value) {
    select.form.requestSubmit();
  }
}
function toggleStateReason(select) { syncStateReason(select, true); }




(function () {
  const select = document.getElementById('ticket-state');
  if (select) syncStateReason(select, false);
})();
</script>
