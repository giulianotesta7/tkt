<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>tkt — Ticket Desk</title>

<script src="/static/sla_countdown.js" defer></script><script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script>
</head>
<body>
<div class="layout">
  <aside class="rail">
    <a class="rail-brand" href="/tickets" title="tkt">tkt</a>
    <nav class="rail-nav">
      <a class="rail-link active" href="/tickets" title="Tickets" aria-label="Tickets">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
      </a>



    </nav>
    <div class="rail-operator" title="Ana Torres">AT</div>
    <form class="rail-logout" method="post" action="/logout">
      <button class="rail-link" type="submit" title="Log out" aria-label="Log out">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3"/><path d="M15 8l4 4-4 4"/><path d="M19 12H9"/></svg>
      </button>
    </form>
  </aside>
  <main class="main">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>


<div id="ticket-detail">

  <div class="command-header">
    <div class="detail-head">
      <div class="meta-row">
        <a href="/tickets">← Queue</a>
        <span class="num">TKT-1</span>
      </div>

      <form class="title-inline" method="post" action="/tickets/1/edit"
            hx-post="/tickets/1/edit" hx-target="#ticket-detail" hx-swap="outerHTML">
        <input type="text" id="ticket-title" name="title" value="Login page down" required
               aria-label="Ticket title" class="title-input">
      </form>

      <div class="meta-row ticket-metadata">
        <span>Created <time datetime="2026-08-06T10:00:00Z">10:00 · 06-08-2026</time></span>
        <span>Updated <time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time></span>
      </div>
    </div>
  </div>
  <div class="cards">
    <div class="conversation">
      <div class="card">
        <h2>Description</h2>
        <p>The login form 500s on submit</p>
          </div>


<form class="card" method="post" action="/tickets/1/comments">
  <h2>Add comment</h2>

  <div class="field">
    <textarea name="body" placeholder="Write a comment…" aria-label="Comment body"></textarea>
  </div>
  <input type="hidden" name="visibility" value="public">

  <div class="field checkbox-field">
    <label for="comment-internal"><input id="comment-internal" type="checkbox" name="internal" value="1"> Internal comment</label>
  </div>

  <button class="btn primary" type="submit">Add comment</button>
</form>

          <div class="card">
        <h2>Timeline</h2>

<div id="timeline">




  <div class="timeline-entry timeline-comment">
    <div class="timeline-entry-head">
      <div class="narrative"><strong class="timeline-actor">Ana Torres</strong> added a public comment</div>
      <span class="when"><time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time></span>
    </div>
    <div class="body">Checking now</div>
  </div>




  <div class="timeline-entry timeline-event">
    <span class="event-icon" aria-hidden="true"></span>
    <div class="body">
      <div class="main"><strong class="timeline-actor">Admin</strong> <span class="timeline-action">assigned the ticket to Ana Torres</span></div>

      <div class="when"><time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time></div>
    </div>
  </div>





  <div class="timeline-entry timeline-event st-in_progress">
    <span class="event-icon" aria-hidden="true"></span>
    <div class="body">
      <div class="main"><strong class="timeline-actor">Admin</strong> <span class="timeline-action">moved the ticket to in progress</span></div>

      <div class="when"><time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time></div>
    </div>
  </div>





  <div class="timeline-entry timeline-event st-new">
    <span class="event-icon" aria-hidden="true"></span>
    <div class="body">
      <div class="main"><strong class="timeline-actor">Admin</strong> <span class="timeline-action">created the ticket</span></div>

      <div class="when"><time datetime="2026-08-06T10:00:00Z">10:00 · 06-08-2026</time></div>
    </div>
  </div>




</div>

      </div>
    </div>
    <div class="evidence">
      <div class="prop-list">
        <div class="prop-section">
          <div class="prop-heading">Properties</div>
          <div class="prop-row">
            <span class="prop-label">Requester</span>
            <span class="prop-value">Ana Torres</span>
          </div>
          <div class="prop-row">
            <span class="prop-label">Category</span>
            <span id="ticket-category-value" class="prop-value">Bugs</span>
          </div>
          <div class="prop-row">
            <span class="prop-label">Priority</span>
            <form class="prop-control" method="post" action="/tickets/1/edit"
                  hx-post="/tickets/1/edit" hx-target="#ticket-detail" hx-swap="outerHTML">
              <select id="ticket-priority" name="priority" class="prop-select"
                      aria-label="Priority">
                <option value="critical" >Critical</option><option value="high" selected>High</option><option value="medium" >Medium</option><option value="low" >Low</option>
              </select>
              <button class="btn small" type="submit">Apply</button>
            </form>
          </div>
        </div>
        <div class="prop-section">
          <div class="prop-heading">Assignment</div>

          <div class="prop-row">
            <span class="prop-label">Assignee</span>

            <form class="prop-control" method="post" action="/tickets/1/assign" hx-post="/tickets/1/assign" hx-target="#ticket-detail" hx-swap="outerHTML">
              <select id="assign-user" name="user_id" class="prop-select" aria-label="Assignee">
                <option value="">Unassigned</option>
                <option value="1" selected>Ana Torres</option>
              </select>
              <button class="btn small" type="submit">Apply</button>
            </form>

          </div>

        </div>
        <div class="prop-section">
          <div class="prop-heading">State</div>
          <div class="prop-row">
            <span class="prop-label">Current</span>
            <span class="prop-value"><span class="badge in_progress">In Progress</span></span>
          </div>

          <div class="prop-row">
            <span class="prop-label">Move to</span>
            <form class="prop-control transition-control" method="post" action="/tickets/1/transition"
                  hx-post="/tickets/1/transition" hx-target="#ticket-detail" hx-swap="outerHTML">
              <select id="ticket-state" name="to" class="prop-select"
                      aria-label="Move to state" required>
                <option value="" disabled selected>Select…</option>
                <option value="resolved">Resolved</option><option value="cancelled">Cancelled</option>
              </select>
              <div id="state-reason-field" class="state-reason-field">
                <label for="state-reason">Reopen reason</label>
                <input type="text" id="state-reason" name="reason" class="state-reason"
                       placeholder="Required" required>
              </div>
              <button type="submit" id="state-apply" class="btn small state-apply">Apply</button>
            </form>
          </div>


        </div>
        <div class="prop-section" data-server-now="2026-08-07T06:00:00Z">
          <div class="prop-heading">SLA</div>

          <div class="prop-row">
            <span class="prop-label">First response</span>
            <span class="prop-value sla-value"><span class="sla-state"><span class="sla-dot met" aria-hidden="true"></span><span class="sla-state-word">Met</span></span> </span>
          </div>

          <div class="prop-row">
            <span class="prop-label">Resolve</span>
            <span class="prop-value sla-value"><span class="sla-state"><span class="sla-dot at_risk" aria-hidden="true"></span><span class="sla-state-word">At Risk</span></span> <time datetime="2026-08-07T10:00:00Z" data-sla-countdown><span class="sla-countdown-ticker" aria-hidden="true">4h 0m</span><span class="sla-countdown-coarse visually-hidden">10:00 · 07-08-2026</span></time></span>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>
<script>






function syncReopenReason(select) {
  const field = document.getElementById('state-reason-field');
  const reason = document.getElementById('state-reason');
  if (!field || !reason) return;
  const opt = select && select.options[select.selectedIndex];
  const needs = opt && opt.hasAttribute('data-needs-reason');
  field.classList.toggle('visible', !!needs);
  reason.required = !!needs;
  if (needs) {
    reason.focus();
  }
}




(function () {
  const select = document.getElementById('ticket-state');
  if (select) syncReopenReason(select);
})();
</script>

</main>
</div>
</body>
</html>
