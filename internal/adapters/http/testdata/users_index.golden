<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>tkt — Ticket Desk</title>

<script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script>
</head>
<body>
<div class="layout">
  <aside class="rail">
    <a class="rail-brand" href="/tickets" title="tkt">tkt</a>
    <nav class="rail-nav">
      <a class="rail-link" href="/tickets" title="Tickets" aria-label="Tickets">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
      </a>



    </nav>
    <div class="rail-operator" title="Ana Torres">AT</div>
    <form class="rail-logout" method="post" action="/logout">
      <button class="rail-link" type="submit" title="Log out" aria-label="Log out">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3"/><path d="M15 8l4 4-4 4"/><path d="M19 12H9"/></svg>
      </button>
    </form>
  </aside>
  <main class="main">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>

<div id="users-root" class="users-root" data-users-status="" data-users-list-url="">
  <div id="users-background">
    <header class="users-header">
      <div>
        <h1 id="users-list-title">Users</h1>
        <p>0 accounts</p>
      </div>
      <a id="users-new-launcher" class="users-primary-action users-new-launcher" href="/users/new" hx-get="/users/new?status=" hx-target="#users-drawer-host" hx-swap="outerHTML" hx-push-url="/users/new" data-edit-url="/users/new">New user</a>
    </header>
        <div class="users-layout">
          <div class="users-filters">
            <nav class="users-status-tabs" aria-label="User status">
              <a href="/users" hx-get="/users" hx-target="#users-root" hx-swap="outerHTML" hx-push-url="true">All <span>0</span></a>
              <a href="/users?status=active" hx-get="/users?status=active" hx-target="#users-root" hx-swap="outerHTML" hx-push-url="true">Active <span>0</span></a>
              <a href="/users?status=deactivated" hx-get="/users?status=deactivated" hx-target="#users-root" hx-swap="outerHTML" hx-push-url="true">Deactivated <span>0</span></a>
            </nav>
            <div class="users-search search-field" role="search">
              <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
              <input type="search" aria-label="Search users" placeholder="Search by name or email..." autocomplete="off">
            </div>
          </div>
          <section class="users-list" aria-labelledby="users-list-title">
        <table>
          <thead><tr><th scope="col">User</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Created</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
          <tbody>
            <tr><td colspan="5"><p class="users-empty"></p></td></tr>

          </tbody>
        </table>
      </section>
      <aside class="users-access-card" aria-labelledby="users-access-title">
        <h2 id="users-access-title">Access levels</h2>
        <p class="users-access-subtitle">Permissions by role</p>
        <dl>
          <div><dt>Root</dt><dd>Full instance access.</dd></div>
          <div><dt>Admin</dt><dd>Manages users, desks, categories and workflows.</dd></div>
          <div><dt>Agent</dt><dd>Handles assigned tickets and moves requests toward resolution.</dd></div>
          <div><dt>User</dt><dd>Creates requests and tracks their progress.</dd></div>
        </dl>
      </aside>
    </div>
  </div>
  <div id="users-drawer-host"></div>
</div>
</main>
</div>
</body>
</html>
