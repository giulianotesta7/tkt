
<form class="card form-card" method="post" action="/tickets">
  <h3>Ticket details</h3>
  
  <div class="field">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" value="Login page down" required autofocus>
  </div>
  <div class="field">
    <label for="description">Description</label>
    <textarea id="description" name="description">The login form 500s on submit</textarea>
  </div>
  <div class="field-row">
    <div class="field">
      <label for="requester_name">Requester name</label>
      <input type="text" id="requester_name" name="requester_name" value="Ana Torres">
    </div>
    <div class="field">
      <label for="requester_email">Requester email</label>
      <input type="email" id="requester_email" name="requester_email" value="ana@example.com">
    </div>
  </div>
  <div class="field-row">
    <div class="field">
      <label for="category_id">Category</label>
      <select id="category_id" name="category_id" required>
        <option value="">Select category</option>
        <option value="1" selected>Bugs</option><option value="2" >Support</option>
      </select>
    </div>
    <div class="field">
      <label for="priority">Priority</label>
      <select id="priority" name="priority">
        <option value="critical" >critical</option><option value="high" selected>high</option><option value="medium" >medium</option><option value="low" >low</option>
      </select>
    </div>
  </div>
  <div class="field">
    <label for="user_id">Assigned user</label>
    <select id="user_id" name="user_id">
      <option value="">Unassigned</option>
      <option value="1" >Ana Torres</option>
    </select>
  </div>
  <button class="btn primary" type="submit">Create ticket</button>
</form>
