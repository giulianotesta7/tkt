<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>tkt — Ticket Desk</title>

<script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script>
</head>
<body>
<div class="layout">
  <aside class="rail">
    <a class="rail-brand" href="/tickets" title="tkt">tkt</a>
    <nav class="rail-nav">
      <a class="rail-link active" href="/tickets" title="Tickets" aria-label="Tickets">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
      </a>



    </nav>
    <div class="rail-operator" title="Ana Torres">AT</div>
    <form class="rail-logout" method="post" action="/logout">
      <button class="rail-link" type="submit" title="Log out" aria-label="Log out">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3"/><path d="M15 8l4 4-4 4"/><path d="M19 12H9"/></svg>
      </button>
    </form>
  </aside>
  <main class="main">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>
<div class="page-foundation tickets-header">
  <header class="page-header">
    <div>
      <h1 class="page-title">Tickets</h1>
    </div>
    <div class="page-actions">
      <a class="page-action page-action-primary" href="/tickets/new">New ticket</a>
    </div>
  </header>
</div><section id="tickets-screen" class="page-foundation tickets-screen"><p class="page-subtitle">2 tickets</p><form class="filter-bar ticket-toolbar" method="get" action="/tickets" hx-get="/tickets" hx-target="#tickets-screen" hx-swap="outerHTML" hx-push-url="true" hx-indicator="this">
  <div class="ticket-search search-field">
  <label class="visually-hidden" for="ticket-search">Search tickets</label>
  <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
  <input id="ticket-search" type="search" name="q" value="" placeholder="Search by ID or title" aria-label="Search tickets">
</div>
  <select name="state" aria-label="State">
    <option value="">All states</option>
    <option value="new" selected>New</option><option value="in_progress" >In Progress</option><option value="resolved" >Resolved</option><option value="closed" >Closed</option><option value="cancelled" >Cancelled</option>
  </select>
  <select name="priority" aria-label="Priority">
    <option value="">All priorities</option>
    <option value="critical" >Critical</option><option value="high" >High</option><option value="medium" >Medium</option><option value="low" >Low</option>
  </select>
  <select name="category_id" aria-label="Category">
    <option value="">All categories</option><option value="1">Bugs</option><option value="2">Support</option>
  </select>
  <select name="user_id" aria-label="Assigned user">
    <option value="">Anyone</option><option value="1">Ana Torres</option>
  </select>
  <select name="sort" aria-label="Order by">
    <option value="newest" selected>Newest first</option>
    <option value="priority" >Priority</option>
    <option value="urgency" >Urgency</option>
  </select>
  <button class="btn" type="submit">Apply</button>
  <a class="btn ghost" href="/tickets" hx-get="/tickets" hx-target="#tickets-screen" hx-swap="outerHTML" hx-push-url="true" aria-label="Clear filters">Clear</a>
  <span class="htmx-indicator spinner" aria-hidden="true"></span>
</form><div id="ticket-list">
  <div class="queue-shell">
    <table class="queue">
      <thead>
        <tr><th>ID</th><th>Title</th><th>State</th><th>Priority</th><th>SLA</th><th>Updated</th></tr>
      </thead>
      <tbody>
        <tr>
          <td class="num" data-label="ID"><a href="/tickets/2">TKT-2</a></td>
          <td class="cell-title" data-label="Title"><a href="/tickets/2">Printer jam</a></td>
          <td data-label="State"><span class="badge in_progress">In Progress</span></td>
          <td class="priority high" data-label="Priority"><span class="ticket-priority-value">High</span></td>
          <td data-label="SLA"><span class="badge at_risk">At Risk</span> <span class="cell-muted">Response <time datetime="2026-08-06T11:30:00Z">11:30 · 06-08-2026</time></span></td>
          <td class="cell-muted" data-label="Updated"><time datetime="2026-08-06T10:30:00Z">10:30 · 06-08-2026</time></td>
        </tr>
        <tr>
          <td class="num" data-label="ID"><a href="/tickets/1">TKT-1</a></td>
          <td class="cell-title" data-label="Title"><a href="/tickets/1">Login page down</a></td>
          <td data-label="State"><span class="badge new">New</span></td>
          <td class="priority critical" data-label="Priority"><span class="ticket-priority-value">Critical</span></td>
          <td data-label="SLA"></td>
          <td class="cell-muted" data-label="Updated"><time datetime="2026-08-06T10:00:00Z">10:00 · 06-08-2026</time></td>
        </tr>
      </tbody>
    </table>
  </div>
</div></section></main>
</div>
</body>
</html>
