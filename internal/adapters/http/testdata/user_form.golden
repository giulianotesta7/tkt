
<form class="card form-card" method="post" action="/users/1/edit">
  <h3>Operator details</h3>
  
  <div class="field">
    <label for="name">Name</label>
    <input type="text" id="name" name="name" value="Ana Torres" required autofocus>
  </div>
  <div class="field">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="ana@example.com" autocomplete="email" required>
  </div>
  <div class="field">
    <label for="password">New password (leave blank to keep)</label>
    <input type="password" id="password" name="password"  autocomplete="new-password">
  </div>
  
  <div class="field">
    <label><input type="checkbox" name="active" checked> Active</label>
    <p class="footnote">Unchecking deactivates the operator — their sessions are killed and they can no longer log in.</p>
  </div>
  
  <button class="btn primary" type="submit">Save changes</button>
</form>
