<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>tkt — Ticket Desk</title>

<script src="/static/save-feedback.js" defer></script><script src="/static/htmx.min.js" defer></script>
</head>
<body>
<div class="layout">
  <aside class="rail">
    <a class="rail-brand" href="/tickets" title="tkt">tkt</a>
    <nav class="rail-nav">
      <a class="rail-link active" href="/tickets" title="Tickets" aria-label="Tickets">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1a2 2 0 0 0 0 4v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1a2 2 0 0 0 0-4V9z"/><path d="M13 7v10"/></svg>
      </a>



    </nav>
    <div class="rail-operator" title="Ana Torres">AT</div>
    <form class="rail-logout" method="post" action="/logout">
      <button class="rail-link" type="submit" title="Log out" aria-label="Log out">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3"/><path d="M15 8l4 4-4 4"/><path d="M19 12H9"/></svg>
      </button>
    </form>
  </aside>
  <main class="main">
<div id="save-feedback" class="save-feedback" role="status" aria-live="polite" aria-atomic="true" hidden data-feedback-message="" data-feedback-kind="">
  <span class="save-feedback-message"></span>
  <button class="save-feedback-dismiss" type="button" aria-label="Dismiss confirmation">Dismiss</button>
</div>
<div class="page-foundation ticket-create-page">

<form class="ticket-create-detail" method="post" action="/tickets">
  <div class="command-header ticket-create-command-header">
    <div class="detail-head">
      <h1 class="command-title">Create a ticket</h1>
      <p class="command-sub">Describe your request.</p>
      <div class="title-inline ticket-create-title-field">
        <label class="ticket-create-title-label" for="title">Title</label>
        <input type="text" id="title" name="title" value="Login page down" required autofocus class="title-input">
      </div>
    </div>
  </div>
  <input type="hidden" name="category_id" value="1">
  <div class="cards">
    <div class="conversation">
      <section class="card ticket-create-description">
        <h2><label for="description">Description</label></h2>
        <textarea id="description" name="description">The login form 500s on submit</textarea>
        <div class="ticket-create-actions"><button class="btn primary" type="submit">Create ticket</button></div>
      </section>
      <section class="card ticket-create-timeline">
        <h2>Timeline</h2>
        <p class="empty">No activity yet.</p>
      </section>
    </div>
    <aside class="evidence" aria-label="Ticket creation properties">
      <div class="prop-list">
        <div class="prop-section">
          <div class="prop-heading">Properties</div>
          <div class="prop-row"><span class="prop-label">Requester</span><span class="prop-value">Ana Torres</span></div>
          <div class="prop-row"><span class="prop-label">Category</span><span class="prop-value selected-catalog-path"><span>Technology / Service desk / Bugs</span><a href="/tickets/new">Change</a></span></div>
          <div class="prop-row"><label class="prop-label" for="priority">Priority</label><select id="priority" name="priority" class="prop-select"><option value="critical" >Critical</option><option value="high" selected>High</option><option value="medium" >Medium</option><option value="low" >Low</option></select></div>
        </div>
        <div class="prop-section">
          <div class="prop-heading">Assignment</div>
          <div class="prop-row"><span class="prop-label">Assignee</span><span class="prop-value">Not assigned yet</span></div>
        </div>
      </div>
    </aside>
  </div>
</form>

</div></main>
</div>
</body>
</html>
